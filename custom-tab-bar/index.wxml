<view class="tabbar-wrap">
  <!-- 左侧胶囊：滑动高亮块 + 4 个 tab -->
  <view class="capsule">
    <view class="capsule-pill" style="transform: translateX({{selected * 100}}%);"></view>
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab {{selected === index ? 'on' : ''}} {{hideText ? 'icon-only' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      hover-class="none"
    >
      <view class="tab-icon icon-{{index}}"></view>
      <view wx:if="{{!hideText}}" class="tab-label">{{item.text}}</view>
    </view>
  </view>

  <!-- 右侧独立 ➕ 圆钮（气泡提示说明它会打开什么） -->
  <view class="plus-wrap">
    <view class="plus-tip {{selected === 1 ? 'tip-plant' : ''}}">{{selected === 1 ? '种一株' : '记物品'}}</view>
    <view class="plus" bindtap="goAdd" hover-class="plus-press" hover-stay-time="80">＋</view>
  </view>
</view>
