/* 文字 */
.tab-label {
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--text-2);
}
.tab.on .tab-label {
  color: var(--text-1);
  font-weight: 600;
}

/* 右侧独立 ➕ 圆钮（品牌黄绿主色） */
.plus {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8b5cf6 0%, #a855f7 55%, #c084fc 100%);
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(168, 85, 247, 0.4);
  transition: transform 0.15s ease;
}

.plus-press {
  transform: scale(0.92);
}
