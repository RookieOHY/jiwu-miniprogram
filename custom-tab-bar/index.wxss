/* 胶囊 TabBar：透明容器负责底部安全区，内部胶囊 + 独立圆钮 */
/* 组件样式隔离会阻断 page 的 CSS 变量继承，这里自备一套（明暗各一） */
.tabbar-wrap {
  --card: #ffffff;
  --text-1: #1c1c1e;
  --chip-text: #8e8e93;
  --accent: #5856D6;
  --accent-soft: rgba(88, 86, 214, 0.12);
  --shadow-1: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --tabbar-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 100;
}

/* 胶囊本体 */
.capsule {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 8rpx;
  background: #ffffff;
  border-radius: 54rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 滑动高亮块：切换时在 tab 间平滑滑动（宽度 = tab 数等分） */
.capsule-pill {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 3);
  border-radius: 46rpx;
  background: #e7d2fb;
  transition: transform 0.28s cubic-bezier(0.3, 0.9, 0.3, 1.1);
  will-change: transform;
}

/* 单个 tab（内容浮在高亮块之上） */
.tab {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 92rpx;
}

/* 图标：Lucide 风格 SVG，灰 → 选中变深 */
.tab-icon {
  width: 40rpx;
  height: 40rpx;
  background-position: center;
  background-repeat: no-repeat;
  background-size: 40rpx 40rpx;
}

