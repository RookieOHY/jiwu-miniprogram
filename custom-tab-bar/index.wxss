/* 文字 */
.tab-label {
  font-size: 22rpx;
  line-height: 1.2;
  color: #8e8e93;
}
.tab.on .tab-label {
  color: #1c1c1e;
  font-weight: 600;
}

/* 选中图标弹性回弹（方案 C） */
.tab.on .tab-icon {
  animation: iconPop 0.32s cubic-bezier(0.3, 1.6, 0.5, 1);
}
@keyframes iconPop {
  0% { transform: scale(0.72); }
  60% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

/* 右侧独立 ➕ 圆钮（品牌紫主色） */
.plus {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #5856D6;
  color: #ffffff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(88, 86, 214, 0.3);
  transition: transform 0.15s ease;
}

.plus-press {
  transform: scale(0.92);
}

/* ============ 夜间模式：只翻转变量 ============ */
@media (prefers-color-scheme: dark) {
  .tabbar-wrap {
    --card: #1C1C1E;
  }
  .capsule {
    background: #1C1C1E;
    box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.5);
  }
  .capsule-pill {
    background: rgba(94, 92, 230, 0.35);
  }
  .tab-label {
    color: #98989d;
  }
  .tab.on {
    background: rgba(94, 92, 230, 0.25);
  }
  .tab-press {
    background: rgba(94, 92, 230, 0.25);
  }
  .tab.on .tab-label {
    color: #8E8EF7;
  }
  .plus {
    background: #5E5CE6;
  }
}
