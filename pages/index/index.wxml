<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="page {{tabAnim}}">

  <!-- 顶部汇总（上滑自动收起） -->
  <view class="hero card {{heroHidden ? 'hero-hidden' : ''}}">
    <view class="hero-main">
      <view class="hero-brand">
        <image class="hero-logo" src="/assets/logo.png" mode="aspectFit"/>
        <view class="hero-label">物资总览</view>
      </view>
      <view class="hero-nums">
        <view class="hero-num-item">
          <view class="hero-num {{numSize}}">{{amountHidden ? '¥****' : '¥' + totalSpend}}</view>
          <view class="hero-num-label-row">
            <text class="hero-num-label">总投入</text>
            <view class="eye {{amountHidden ? 'eye-off' : ''}}" catchtap="toggleHide"></view>
          </view>
        </view>
        <view class="hero-num-item">
          <view class="hero-num {{numSize}}">{{amountHidden ? '¥****' : '¥' + totalPeriodValue}}</view>
          <view class="hero-num-label-row">
            <text class="hero-num-label">{{periodLabel}}</text>
            <view class="period-cycle" catchtap="cyclePeriod"></view>
          </view>
        </view>
        <view class="hero-num-item">
          <view class="hero-num {{numSize}}">{{count}}</view>
          <view class="hero-num-label">总件数</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索 + 筛选 + 视图切换 -->
  <view class="toolbar">
    <view class="search-box">
      <view class="search-ico"></view>
      <input class="search-input" placeholder="搜索物品名称 / 标签 / 备注" placeholder-class="ph" value="{{searchKeyword}}" bindinput="onSearch"/>
      <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">×</view>
    </view>
    <view class="bell-btn" bindtap="goReminders">
      <view class="bell-ico"></view>
      <view wx:if="{{reminderCount}}" class="bell-badge">{{reminderCount > 9 ? '9+' : reminderCount}}</view>
    </view>
    <view class="filter-btn" bindtap="openFilter">筛选<text wx:if="{{filterCount}}" class="filter-badge">{{filterCount}}</text></view>
    <view class="view-toggle vt-{{viewMode === 'list' ? 'to-card' : viewMode === 'card' ? 'to-cat' : viewMode === 'cat' ? 'to-loc' : 'to-list'}}" bindtap="toggleView"></view>
  </view>

  <!-- 生效条件胶囊 -->
  <view wx:if="{{activeChips.length}}" class="active-chips">
    <view wx:for="{{activeChips}}" wx:key="key" class="active-chip" data-k="{{item.key}}" bindtap="removeChip">{{item.label}} ×</view>
  </view>

  <!-- 物品列表（列表视图） -->
  <block wx:if="{{viewMode === 'list'}}">
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty-icon">📦</view>
      <view>还没有记录任何物品</view>
      <view class="empty-tip">点右下角 ➕ 记下第一件 ↘</view>
    </view>

    <view
      wx:for="{{items}}"
      wx:key="id"
      class="item card"
      hover-class="item-press"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="goDetail"
      bindlongpress="onItemLongPress"
    >
      <!-- 时间线轨道：徽章 + 竖向虚线 -->
      <view class="tl-rail">
        <image class="cat-badge" src="{{item.iconSrc}}" mode="aspectFit"/>
        <view wx:if="{{showTl && index < items.length - 1}}" class="tl-line"></view>
      </view>

      <view class="item-main">
        <view class="item-name">
          {{item.name}}
          <text wx:if="{{item.pinned}}" class="pin-mark"></text>
          <text wx:if="{{item.sold}}" class="tag-sold">已卖出</text>
          <text wx:elif="{{item.retired}}" class="tag-retired">已退役</text>
        </view>
        <view class="item-meta">
          <text class="tcat-{{item.category}}">{{item.catName}}</text>
          <text class="sep"> · </text>
          <text class="tpf-{{item.platform}}">{{item.platformName}}</text>
          <text class="sep"> · </text>已持有 {{item.days}} 天
        </view>
      </view>

      <view class="item-right">
        <view class="item-daily-big">{{amountHidden ? '****' : item.symbol + item.daily}}<text class="per">/天</text></view>
        <view class="item-buy">{{amountHidden ? '买入 ****' : '买入 ' + item.symbol + item.price}}</view>
      </view>
    </view>
  </block>

  <!-- 物品网格（卡片视图） -->
  <block wx:if="{{viewMode === 'card'}}">
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty-icon">📦</view>
      <view>还没有记录任何物品</view>
      <view class="empty-tip">点右下角 ➕ 记下第一件 ↘</view>
    </view>

    <view class="grid">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="gcard"
        hover-class="gcard-press"
        hover-stay-time="80"
        data-id="{{item.id}}"
        bindtap="goDetail"
        bindlongpress="onItemLongPress"
      >
        <view class="gcard-body">
          <view class="gcard-head">
            <image class="cat-badge" src="{{item.iconSrc}}" mode="aspectFit"/>
            <view class="tape" wx:if="{{item.pinned}}"></view>
            <view class="gcard-headright">
              <text wx:if="{{item.sold}}" class="tag-sold">已卖出</text>
              <text wx:elif="{{item.retired}}" class="tag-retired">已退役</text>
            </view>
          </view>
          <view class="gcard-name">{{item.name}}</view>
          <view class="gcard-cat">
            <text class="tcat-{{item.category}}">{{item.catName}}</text>
            <text class="sep"> · </text>
            <text class="tpf-{{item.platform}}">{{item.platformName}}</text>
          </view>
          <view class="gcard-daily-row">
            <view class="gcard-daily-big">{{amountHidden ? '****' : item.symbol + item.daily}}<text class="per">/天</text></view>
            <text class="gcard-days">{{item.days}} 天</text>
          </view>
          <view class="gcard-price">{{amountHidden ? '买入 ****' : '买入 ' + item.symbol + item.price}}</view>
        </view>
      </view>
    </view>
  </block>
  <block wx:if="{{viewMode === 'cat'}}">
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty-icon">📦</view>
      <view>还没有记录任何物品</view>
      <view class="empty-tip">点右下角 ➕ 记下第一件 ↘</view>
    </view>

    <view wx:for="{{catView}}" wx:key="name" class="cat-sec">
      <view class="cat-sec-head">
        <view class="cat-sec-left">
          <image class="cat-sec-ico" src="{{item.icon}}" mode="aspectFit"/>
          <text class="cat-sec-name">{{item.name}}</text>
        </view>
        <text class="loc-sec-sum">{{item.items.length}} 件 · {{amountHidden ? '¥****' : '¥' + item.spendText}}</text>
      </view>
      <view
        wx:for="{{item.items}}"
        wx:for-item="it"
        wx:key="id"
        class="catview-item card"
        hover-class="item-press"
        hover-stay-time="80"
        data-id="{{it.id}}"
        bindtap="goDetail"
        bindlongpress="onItemLongPress"
      >
        <view class="item-main">
          <view class="item-name">
            {{it.name}}
            <text wx:if="{{it.sold}}" class="tag-sold">已卖出</text>
            <text wx:elif="{{it.retired}}" class="tag-retired">已退役</text>
          </view>
          <view class="item-meta">已持有 {{it.days}} 天</view>
        </view>
        <view class="item-right">
          <view class="item-daily-big">{{amountHidden ? '****' : it.symbol + it.daily}}<text class="per">/天</text></view>
          <view class="item-buy">{{amountHidden ? '买入 ****' : '买入 ' + it.symbol + it.price}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 位置视图：按存放位置归置 -->
  <block wx:if="{{viewMode === 'loc'}}">
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty-icon">📍</view>
      <view>还没有记录任何物品</view>
      <view class="empty-tip">点右下角 ➕ 记下第一件 ↘</view>
    </view>

    <view wx:for="{{locView}}" wx:key="name" class="cat-sec">
      <view class="cat-sec-head">
        <view class="cat-sec-left">
          <image class="cat-sec-ico" src="{{item.icon}}" mode="aspectFit"/>
          <text class="cat-sec-name">{{item.title}}</text>
        </view>
        <text class="loc-sec-sum">{{item.items.length}} 件 · {{amountHidden ? '¥****' : '¥' + item.spendText}}</text>
      </view>
      <view
        wx:for="{{item.items}}"
        wx:for-item="it"
        wx:key="id"
        class="catview-item card"
        hover-class="item-press"
        hover-stay-time="80"
        data-id="{{it.id}}"
        bindtap="goDetail"
        bindlongpress="onItemLongPress"
      >
        <view class="item-main">
          <view class="item-name">
            {{it.name}}
            <text wx:if="{{it.sold}}" class="tag-sold">已卖出</text>
            <text wx:elif="{{it.retired}}" class="tag-retired">已退役</text>
          </view>
          <view class="item-meta">{{it.catName}} · 已持有 {{it.days}} 天</view>
        </view>
        <view class="item-right">
          <view class="item-daily-big">{{amountHidden ? '****' : it.symbol + it.daily}}<text class="per">/天</text></view>
          <view class="item-buy">{{amountHidden ? '买入 ****' : '买入 ' + it.symbol + it.price}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{locView.length}}" class="loc-tip">位置写在物品详情页「存放位置」那一行，点一下就能改</view>
  </block>

  <view class="bottom-space"></view>
</view>

<!-- 筛选面板 -->
<view wx:if="{{showFilter}}" class="flt-mask" bindtap="closeFilter">
  <view class="flt-panel" catchtap="noop">
    <view class="flt-head">
      <text class="flt-cancel" bindtap="closeFilter">取消</text>
      <text class="flt-title">筛选与排序</text>
      <text class="flt-reset" bindtap="resetFilter">重置</text>
    </view>
    <scroll-view scroll-y class="flt-body">
      <view class="flt-sec-title">状态</view>
      <view class="flt-chips">
        <view wx:for="{{statusOptions}}" wx:key="*this" class="flt-chip {{fmt.has(statuses, item) ? 'on' : ''}}" data-v="{{item}}" bindtap="toggleStatus">{{item}}</view>
      </view>

      <view class="flt-sec-title">分类</view>
      <view class="flt-chips">
        <view wx:for="{{catGroups}}" wx:key="name" class="flt-chip {{selGroup === item.name ? 'on' : ''}}" data-name="{{item.name}}" bindtap="setGroup">{{item.name}}</view>
      </view>
      <view wx:if="{{selGroup}}" class="flt-chips sub">
        <block wx:for="{{catGroups}}" wx:key="name" wx:for-item="g">
          <block wx:if="{{g.name === selGroup}}">
            <view wx:for="{{g.subs}}" wx:for-item="s" wx:key="*this" class="flt-chip {{selSub === s ? 'on' : ''}}" data-sub="{{s}}" bindtap="setSub">{{s}}</view>
          </block>
        </block>
      </view>

      <view class="flt-sec-title">购买渠道</view>
      <view class="flt-chips">
        <view wx:for="{{platforms}}" wx:key="key" class="flt-chip {{fmt.has(selPlatforms, item.key) ? 'on' : ''}}" data-v="{{item.key}}" bindtap="togglePlatform">{{item.name}}</view>
      </view>

      <view class="flt-sec-title">价格区间（¥）</view>
      <view class="flt-range">
        <input class="flt-input" type="digit" placeholder="最低" placeholder-class="ph" value="{{minPrice}}" bindinput="onMinPrice"/>
        <text class="flt-dash">~</text>
        <input class="flt-input" type="digit" placeholder="最高" placeholder-class="ph" value="{{maxPrice}}" bindinput="onMaxPrice"/>
      </view>

      <view class="flt-sec-title">购买日期</view>
      <view class="flt-range">
        <picker mode="date" value="{{dateFrom}}" bindchange="onDateFrom"><view class="flt-date">{{dateFrom || '开始日期'}}</view></picker>
        <text class="flt-dash">~</text>
        <picker mode="date" value="{{dateTo}}" bindchange="onDateTo"><view class="flt-date">{{dateTo || '结束日期'}}</view></picker>
      </view>

      <view class="flt-sec-title">标签</view>
      <view class="flt-chips">
        <view wx:for="{{allTags}}" wx:key="*this" class="flt-chip {{fmt.has(selTags, item) ? 'on' : ''}}" data-v="{{item}}" bindtap="toggleTag">{{item}}</view>
      </view>

      <view class="flt-sec-title">品牌</view>
      <view class="flt-chips" wx:if="{{allBrands.length}}">
        <view wx:for="{{allBrands}}" wx:key="*this" class="flt-chip {{fmt.has(selBrands, item) ? 'on' : ''}}" data-v="{{item}}" data-k="selBrands" bindtap="toggleFacet">{{item}}</view>
      </view>
      <view class="flt-sub-note" wx:if="{{!allBrands.length}}">还没有物品填了品牌，详情页「编辑」里可补</view>

      <view class="flt-sec-title">颜色</view>
      <view class="flt-chips" wx:if="{{allColors.length}}">
        <view wx:for="{{allColors}}" wx:key="*this" class="flt-chip {{fmt.has(selColors, item) ? 'on' : ''}}" data-v="{{item}}" data-k="selColors" bindtap="toggleFacet">{{item}}</view>
      </view>
      <view class="flt-sub-note" wx:if="{{!allColors.length}}">还没有物品填了颜色</view>

      <view class="flt-sec-title">季节</view>
      <view class="flt-chips" wx:if="{{allSeasons.length}}">
        <view wx:for="{{allSeasons}}" wx:key="*this" class="flt-chip {{fmt.has(selSeasons, item) ? 'on' : ''}}" data-v="{{item}}" data-k="selSeasons" bindtap="toggleFacet">{{item}}</view>
      </view>
      <view class="flt-sub-note" wx:if="{{!allSeasons.length}}">还没有物品填了季节</view>

      <view class="flt-sec-title">币种</view>
      <view class="flt-chips">
        <view wx:for="{{currencies}}" wx:key="key" class="flt-chip {{selCurrency === item.key ? 'on' : ''}}" data-v="{{item.key}}" bindtap="setCurrency">{{item.symbol}} {{item.name}}</view>
      </view>

      <view class="flt-sec-title">视图</view>
      <view class="flt-chips">
        <view wx:for="{{viewOptions}}" wx:key="key" class="flt-chip {{viewMode === item.key ? 'on' : ''}}" data-v="{{item.key}}" bindtap="setView">{{item.name}}</view>
      </view>

      <view class="flt-sec-title">排序</view>
      <view class="flt-chips">
        <view wx:for="{{sortOptions}}" wx:key="key" class="flt-chip {{sortBy === item.key ? 'on' : ''}}" data-v="{{item.key}}" bindtap="setSort">{{item.name}}</view>
      </view>
    </scroll-view>
    <button class="flt-ok" bindtap="closeFilter">查看 {{items.length}} 件物品</button>
  </view>
</view>

<!-- 值回票价日：全屏庆祝卡 -->
<view wx:if="{{celebrating}}" class="cele-mask">
  <view class="cele-card">
    <view class="cele-emoji">🎉</view>
    <view class="cele-badge">值回票价日</view>
    <view class="cele-name">{{celebrating.name}}</view>
    <view class="cele-line">{{celebrating.symbol}}{{celebrating.price}} · 用了 {{celebrating.days}} 天</view>
    <view class="cele-big">今天起，每个使用日都是赚的</view>
    <view class="cele-sub">第 {{celebrating.need}} 天，日均已降到目标以下</view>
    <view class="cele-actions">
      <view class="cele-sub-row">
        <button class="cele-save" bindtap="savePoster">保存图片</button>
        <view class="cele-close" bindtap="closeCelebration">知道了</view>
      </view>
    </view>
  </view>
</view>

<!-- 海报绘制用离屏画布 -->
<canvas type="2d" id="celeCanvas" class="cele-canvas"></canvas>
