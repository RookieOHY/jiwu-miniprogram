<view class="page">

  <!-- 顶部汇总（上滑自动收起） -->
  <view class="hero card {{heroHidden ? 'hero-hidden' : ''}}">
    <view class="hero-main">
      <view class="hero-label">累计投入</view>
      <view class="hero-num">¥{{totalSpend}}</view>
      <view class="hero-sub">共 {{count}} 件物品 · 今日支出 ¥{{todaySpend}}</view>
    </view>
    <view class="hero-btn" bindtap="goStats">统计 ↗</view>
  </view>

  <!-- 筛选 + 视图切换 -->
  <view class="toolbar">
    <view class="filters">
      <view
        wx:for="{{['all','持有中','已退役','已卖出']}}"
        wx:key="*this"
        class="filter-chip {{filter === item ? 'on' : ''}}"
        data-f="{{item}}"
        bindtap="setFilter"
      >{{item === 'all' ? '全部' : item}}</view>
    </view>
    <view class="view-toggle {{viewMode === 'list' ? 'to-card' : 'to-list'}}" bindtap="toggleView"></view>
  </view>

  <!-- 物品列表（列表视图） -->
  <block wx:if="{{viewMode === 'list'}}">
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty-icon">📦</view>
      <view>还没有记录任何物品</view>
      <view class="empty-tip">点击下方按钮，记下第一件吧</view>
    </view>

    <view
      wx:for="{{items}}"
      wx:key="id"
      class="item card"
      data-id="{{item.id}}"
      bindtap="goDetail"
      bindlongpress="onItemLongPress"
    >
      <view class="cat-dot cat-{{item.category}}"></view>
      <view class="item-main">
        <view class="item-name">
          <view wx:if="{{item.pinned}}" class="pin-mark"></view>
          {{item.name}}
          <text wx:if="{{item.sold}}" class="tag-sold">已卖出</text>
          <text wx:elif="{{item.retired}}" class="tag-retired">已退役</text>
        </view>
        <view class="item-meta">
          <text class="tcat-{{item.category}}">{{item.catName}}</text>
          <text class="sep"> · </text>
          <text class="tpf-{{item.platform}}">{{item.platformName}}</text>
          <text class="sep"> · </text>{{item.buyDate}} · 已持有 {{item.days}} 天
        </view>
      </view>
      <view class="item-right">
        <view class="item-price">{{item.symbol}}{{item.price}}</view>
        <view class="item-daily">日均 {{item.symbol}}{{item.daily}}</view>
      </view>
    </view>
  </block>

  <!-- 物品网格（卡片视图） -->
  <block wx:else>
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty-icon">📦</view>
      <view>还没有记录任何物品</view>
      <view class="empty-tip">点击下方按钮，记下第一件吧</view>
    </view>

    <view class="grid">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="gcard"
        hover-class="gcard-press"
        hover-stay-time="80"
        data-id="{{item.id}}"
        bindtap="goDetail"
        bindlongpress="onItemLongPress"
      >
        <view class="gcard-body">
          <view class="gcard-head">
            <view class="cat-badge badge-{{item.category}}"></view>
            <view class="gcard-headright">
              <view wx:if="{{item.pinned}}" class="pin-mark"></view>
              <text wx:if="{{item.sold}}" class="tag-sold">已卖出</text>
              <text wx:elif="{{item.retired}}" class="tag-retired">已退役</text>
            </view>
          </view>
          <view class="gcard-name">{{item.name}}</view>
          <view class="gcard-cat">
            <text class="tcat-{{item.category}}">{{item.catName}}</text>
            <text class="sep"> · </text>
            <text class="tpf-{{item.platform}}">{{item.platformName}}</text>
          </view>
          <view class="gcard-daily-big">{{item.symbol}}{{item.daily}}<text class="per">/天</text></view>
          <view class="gcard-price">买入 {{item.symbol}}{{item.price}}</view>
          <view class="gcard-bar-row">
            <view class="gcard-bar-track">
              <view class="gcard-bar cat-{{item.category}}" style="width: {{item.bar}}%;"></view>
            </view>
            <text class="gcard-days">{{item.days}} 天</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="bottom-space"></view>
</view>

<!-- 悬浮添加按钮 -->
<view class="fab" bindtap="goAdd">＋</view>
