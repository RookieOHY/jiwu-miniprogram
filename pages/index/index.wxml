<view class="page {{tabAnim}}">

  <!-- 顶部汇总（上滑自动收起） -->
  <view class="hero card {{heroHidden ? 'hero-hidden' : ''}}">
    <view class="hero-main">
      <view class="hero-brand">
        <image class="hero-logo" src="/assets/logo.png" mode="aspectFit"/>
        <view class="hero-label">物资总览</view>
      </view>
      <view class="hero-nums">
        <view class="hero-num-item">
          <view class="hero-num">{{amountHidden ? '¥****' : '¥' + totalSpend}}</view>
          <view class="hero-num-label-row">
            <text class="hero-num-label">总投入</text>
            <view class="eye {{amountHidden ? 'eye-off' : ''}}" catchtap="toggleHide"></view>
          </view>
        </view>
        <view class="hero-num-item">
          <view class="hero-num">{{amountHidden ? '¥****' : '¥' + totalDaily}}</view>
          <view class="hero-num-label">总日均</view>
        </view>
        <view class="hero-num-item">
          <view class="hero-num">{{count}}</view>
          <view class="hero-num-label">总件数</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 筛选 + 视图切换 -->
  <view class="toolbar">
    <view class="filters">
      <view class="filter-chip {{filter === 'all' ? 'on' : ''}}" data-f="all" bindtap="setFilter">全部</view>
      <view class="filter-chip {{filter === '持有中' ? 'on' : ''}}" data-f="持有中" bindtap="setFilter">持有中</view>
      <view class="filter-chip {{filter === '已退役' ? 'on' : ''}}" data-f="已退役" bindtap="setFilter">已退役</view>
      <view class="filter-chip {{filter === '已卖出' ? 'on' : ''}}" data-f="已卖出" bindtap="setFilter">已卖出</view>
    </view>
    <view class="view-toggle {{viewMode === 'list' ? 'to-card' : 'to-list'}}" bindtap="toggleView"></view>
  </view>

  <!-- 物品列表（列表视图） -->
  <block wx:if="{{viewMode === 'list'}}">
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty-icon">📦</view>
      <view>还没有记录任何物品</view>
      <view class="empty-tip">点击下方按钮，记下第一件吧</view>
    </view>

    <view
      wx:for="{{items}}"
      wx:key="id"
      class="item card"
      hover-class="item-press"
      hover-stay-time="80"
      data-id="{{item.id}}"
      bindtap="goDetail"
      bindlongpress="onItemLongPress"
    >
      <!-- 时间线轨道：徽章 + 竖向虚线 -->
      <view class="tl-rail">
        <view class="cat-badge badge-{{item.category}}"></view>
        <view wx:if="{{index < items.length - 1}}" class="tl-line"></view>
      </view>

      <view class="item-main">
        <view class="item-name">
          {{item.name}}
          <text wx:if="{{item.pinned}}" class="pin-mark"></text>
          <text wx:if="{{item.sold}}" class="tag-sold">已卖出</text>
          <text wx:elif="{{item.retired}}" class="tag-retired">已退役</text>
        </view>
        <view class="item-meta">
          <text class="tcat-{{item.category}}">{{item.catName}}</text>
          <text class="sep"> · </text>
          <text class="tpf-{{item.platform}}">{{item.platformName}}</text>
          <text class="sep"> · </text>已持有 {{item.days}} 天
        </view>
      </view>

      <view class="item-right">
        <view class="item-daily-big">{{item.symbol}}{{item.daily}}<text class="per">/天</text></view>
        <view class="item-buy">买入 {{item.symbol}}{{item.price}}</view>
      </view>
    </view>
  </block>

  <!-- 物品网格（卡片视图） -->
  <block wx:else>
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty-icon">📦</view>
      <view>还没有记录任何物品</view>
      <view class="empty-tip">点击下方按钮，记下第一件吧</view>
    </view>

    <view class="grid">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="gcard"
        hover-class="gcard-press"
        hover-stay-time="80"
        data-id="{{item.id}}"
        bindtap="goDetail"
        bindlongpress="onItemLongPress"
      >
        <view class="gcard-body">
          <view class="gcard-head">
            <view class="cat-badge badge-{{item.category}}"></view>
            <view class="tape" wx:if="{{item.pinned}}"></view>
            <view class="gcard-headright">
              <text wx:if="{{item.sold}}" class="tag-sold">已卖出</text>
              <text wx:elif="{{item.retired}}" class="tag-retired">已退役</text>
            </view>
          </view>
          <view class="gcard-name">{{item.name}}</view>
          <view class="gcard-cat">
            <text class="tcat-{{item.category}}">{{item.catName}}</text>
            <text class="sep"> · </text>
            <text class="tpf-{{item.platform}}">{{item.platformName}}</text>
          </view>
          <view class="gcard-daily-row">
            <view class="gcard-daily-big">{{item.symbol}}{{item.daily}}<text class="per">/天</text></view>
            <text class="gcard-days">{{item.days}} 天</text>
          </view>
          <view class="gcard-price">买入 {{item.symbol}}{{item.price}}</view>
        </view>
      </view>
    </view>
  </block>

  <view class="bottom-space"></view>
</view>

<!-- 值回票价日：全屏庆祝卡 -->
<view wx:if="{{celebrating}}" class="cele-mask">
  <view class="cele-card">
    <view class="cele-emoji">🎉</view>
    <view class="cele-badge">值回票价日</view>
    <view class="cele-name">{{celebrating.name}}</view>
    <view class="cele-line">{{celebrating.symbol}}{{celebrating.price}} · 用了 {{celebrating.days}} 天</view>
    <view class="cele-big">今天起，每个使用日都是赚的</view>
    <view class="cele-sub">第 {{celebrating.need}} 天，日均已降到目标以下</view>
    <view class="cele-actions">
      <button class="cele-share" open-type="share">转发炫耀</button>
      <button class="cele-save" bindtap="savePoster">保存图片 · 发朋友圈</button>
      <view class="cele-close" bindtap="closeCelebration">先收下</view>
    </view>
  </view>
</view>

<!-- 海报绘制用离屏画布 -->
<canvas type="2d" id="celeCanvas" class="cele-canvas"></canvas>
