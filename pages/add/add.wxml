<view class="page">

  <!-- 更多添加方式（默认折叠，展开后三个功能入口，暂不接逻辑） -->
  <view class="sec-toggle" bindtap="toggleMore">
    <text>更多添加方式</text>
    <view class="chev {{moreWays ? 'up' : ''}}"></view>
  </view>
  <view wx:if="{{moreWays}}" class="more-ways">
    <view class="more-item" bindtap="goFullAdd">
      <text>详细添加</text>
      <view class="more-arrow">›</view>
    </view>
    <view class="more-item">
      <text>识别添加</text>
      <view class="more-arrow">›</view>
    </view>
    <view class="more-item">
      <text>CSV 添加</text>
      <view class="more-arrow">›</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="sec-title">基本信息</view>
  <view class="card form basics">
    <view class="field plain">
      <input
        class="input"
        placeholder="请输入物品名称"
        placeholder-class="ph"
        value="{{name}}"
        bindinput="onName"
        focus
      />
    </view>

    <view class="field plain price-field">
      <input
        class="input"
        type="digit"
        placeholder="请输入购买价格"
        placeholder-class="ph"
        value="{{price}}"
        bindinput="onPrice"
      />
      <view class="calc-icon" catchtap="openCalc"></view>
    </view>

    <view class="field plain date-field">
      <view class="date-label">购买日期</view>
      <picker mode="date" value="{{buyDate}}" end="{{maxDate}}" bindchange="onDate">
        <view class="date-chip">{{buyDateCN}}</view>
      </picker>
    </view>
  </view>

  <!-- 可选补充（暂为界面占位，不接逻辑） -->
  <view class="sec-title">可选补充</view>
  <view class="opt-grid">
    <view class="opt-chip">
      <view class="opt-ico ico-cat"></view>
      <text>选择分类</text>
    </view>
    <view class="opt-chip" bindtap="openIconPanel">
      <view class="opt-ico ico-img"></view>
      <text>选择图标</text>
    </view>
    <view class="opt-chip">
      <view class="opt-ico ico-pin"></view>
      <text>存放位置</text>
    </view>
    <view class="opt-chip">
      <view class="opt-ico ico-bag"></view>
      <text>购买渠道</text>
    </view>
    <view class="opt-chip">
      <view class="opt-ico ico-tag"></view>
      <text>标签</text>
    </view>
  </view>

  <view class="bottom-gap"></view>
  <button class="btn-primary save-btn {{canSave ? '' : 'dim'}}" disabled="{{!canSave}}" bindtap="save">
    {{isEdit ? '保存修改' : '记一笔'}}
  </button>
</view>

<!-- 计算器底部弹层 -->
<view wx:if="{{showCalc}}" class="calc-mask" bindtap="closeCalc">
  <view class="calc-panel" catchtap="noop">
    <view class="calc-display">{{calcDisplay}}</view>
    <view class="calc-grid">
      <view class="calc-key key-fn span2" data-k="C" bindtap="calcKey">C</view>
      <view class="calc-key key-fn" data-k="÷" bindtap="calcKey">÷</view>
      <view class="calc-key key-fn" data-k="×" bindtap="calcKey">×</view>
      <view class="calc-key key-num" data-k="7" bindtap="calcKey">7</view>
      <view class="calc-key key-num" data-k="8" bindtap="calcKey">8</view>
      <view class="calc-key key-num" data-k="9" bindtap="calcKey">9</view>
      <view class="calc-key key-fn" data-k="−" bindtap="calcKey">−</view>
      <view class="calc-key key-num" data-k="4" bindtap="calcKey">4</view>
      <view class="calc-key key-num" data-k="5" bindtap="calcKey">5</view>
      <view class="calc-key key-num" data-k="6" bindtap="calcKey">6</view>
      <view class="calc-key key-fn" data-k="+" bindtap="calcKey">+</view>
      <view class="calc-key key-num" data-k="1" bindtap="calcKey">1</view>
      <view class="calc-key key-num" data-k="2" bindtap="calcKey">2</view>
      <view class="calc-key key-num" data-k="3" bindtap="calcKey">3</view>
      <view class="calc-key key-eq" data-k="=" bindtap="calcKey">=</view>
      <view class="calc-key key-num span2" data-k="0" bindtap="calcKey">0</view>
      <view class="calc-key key-num" data-k="." bindtap="calcKey">.</view>
      <view class="calc-key key-fn" data-k="back" bindtap="calcKey">⌫</view>
    </view>
    <button class="calc-fill" bindtap="applyCalc">填入价格</button>
  </view>
</view>

<!-- 图标选择面板（半屏弹层） -->
<view wx:if="{{showIconPanel}}" class="icon-mask" bindtap="closeIconPanel">
  <view class="icon-panel" catchtap="noop">
    <view class="icon-panel-head">
      <text class="icon-panel-cancel" bindtap="closeIconPanel">取消</text>
      <text class="icon-panel-title">选择图标</text>
      <text class="icon-panel-ok" bindtap="closeIconPanel">确定</text>
    </view>

    <view class="icon-panel-actions">
      <view class="icon-action" data-src="album" bindtap="pickPhoto">🖼️ 从图库选择</view>
      <view class="icon-action" data-src="camera" bindtap="pickPhoto">📷 拍照</view>
    </view>

    <view class="icon-tabs">
      <view class="icon-tab {{iconTab === 'emoji' ? 'on' : ''}}" data-tab="emoji" bindtap="setIconTab">Emoji</view>
      <view class="icon-tab {{iconTab === '3d' ? 'on' : ''}}" data-tab="3d" bindtap="setIconTab">3D 图标</view>
    </view>

    <view class="icon-search">
      <input
        class="icon-search-input"
        placeholder="搜索（如：手机 咖啡 相机）"
        placeholder-class="ph"
        value="{{iconKeyword}}"
        bindinput="onIconSearch"
      />
    </view>

    <scroll-view scroll-y class="icon-grid-scroll">
      <view wx:if="{{iconTab === 'emoji'}}" class="icon-grid">
        <view
          wx:for="{{emojiList}}"
          wx:key="index"
          class="icon-cell"
          data-e="{{item.e}}"
          bindtap="pickEmoji"
        >
          <text class="icon-cell-emoji">{{item.e}}</text>
          <text class="icon-cell-name">{{item.name}}</text>
        </view>
        <view wx:if="{{!emojiList.length}}" class="icon-empty">没有匹配的 emoji</view>
      </view>

      <view wx:else class="icon-grid">
        <view
          wx:for="{{icon3dList}}"
          wx:key="key"
          class="icon-cell"
          data-src="{{item.src}}"
          bindtap="pick3d"
        >
          <image class="icon-cell-img" src="{{item.src}}" mode="aspectFit"/>
          <text class="icon-cell-name">{{item.name}}</text>
        </view>
        <view wx:if="{{!icon3dList.length}}" class="icon-empty">没有匹配的 3D 图标</view>
      </view>
    </scroll-view>
  </view>
</view>
