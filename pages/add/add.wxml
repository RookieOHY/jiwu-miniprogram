<view class="page">
  <view class="card form">

    <view class="field">
      <view class="label">物品名称</view>
      <input
        class="input"
        placeholder="例如：iPhone 15 / 人体工学椅"
        placeholder-class="ph"
        value="{{name}}"
        bindinput="onName"
        focus
      />
    </view>

    <view class="field">
      <view class="label">花费（元）</view>
      <input
        class="input"
        type="digit"
        placeholder="0.00"
        placeholder-class="ph"
        value="{{price}}"
        bindinput="onPrice"
      />
    </view>

    <view class="field">
      <view class="label">购买日期</view>
      <picker mode="date" value="{{buyDate}}" end="{{maxDate}}" bindchange="onDate">
        <view class="input picker-val">{{buyDate}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">分类</view>
      <view class="cat-grid">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="cat-opt {{category === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onCat"
        >
          <view class="cat-opt-dot cat-{{item.key}}"></view>
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="label">购买渠道</view>
      <view class="cat-grid">
        <view
          wx:for="{{platforms}}"
          wx:key="key"
          class="cat-opt {{platform === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPlatform"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="field">
      <view class="label">备注（可选）</view>
      <input
        class="input"
        placeholder="型号、渠道、感受…"
        placeholder-class="ph"
        value="{{note}}"
        bindinput="onNote"
      />
    </view>
  </view>

  <button class="btn-primary save-btn {{canSave ? '' : 'dim'}}" disabled="{{!canSave}}" bindtap="save">
    记一笔
  </button>
</view>
