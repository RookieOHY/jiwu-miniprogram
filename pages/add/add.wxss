.page {
  padding: 24rpx;
}
.form {
  margin-bottom: 40rpx;
}
.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.field:last-child {
  border-bottom: none;
}
.label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.input {
  font-size: 32rpx;
  padding: 8rpx 0;
}
.ph {
  color: var(--text-3);
}
.picker-val {
  font-weight: 600;
  font-family: "DIN Alternate", sans-serif;
}
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cat-opt {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
  background: var(--chip);
  color: var(--chip-text);
}
.cat-opt.on {
  background: linear-gradient(135deg, #8b5cf6, #c084fc);
  color: #ffffff;
}
.cat-opt-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.save-btn.dim {
  opacity: 0.4;
}
.save-btn {
  margin-top: 8rpx;
}
.cur-seg {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.cur-opt {
  font-size: 24rpx;
  padding: 6rpx 22rpx;
  border-radius: 28rpx;
  background: var(--chip);
  color: var(--chip-text);
}
.cur-opt.on {
  background: linear-gradient(135deg, #8b5cf6, #c084fc);
  color: #ffffff;
}
.more-opt {
  background: var(--chip);
  color: var(--chip-text);
}
