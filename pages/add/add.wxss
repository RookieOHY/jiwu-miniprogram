.page {
  padding: 24rpx;
}
.form {
  margin-bottom: 40rpx;
}
.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.field:last-child {
  border-bottom: none;
}
.label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.input {
  font-size: 32rpx;
  padding: 8rpx 0;
}
.ph {
  color: var(--text-3);
}
.picker-val {
  font-weight: 600;
  font-family: "DIN Alternate", sans-serif;
}
.cat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.cat-opt {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
  background: var(--chip);
  color: var(--chip-text);
}
.cat-opt.on {
  background: linear-gradient(135deg, #8b5cf6, #c084fc);
  color: #ffffff;
}
.cat-opt-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.save-btn.dim {
  opacity: 0.4;
}
.save-btn {
  margin-top: 8rpx;
}

/* ---------- 物品图标预览 ---------- */
.icon-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 36rpx;
}
.icon-preview {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: 44rpx;
  background: var(--card);
  box-shadow: var(--shadow-1);
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-preview-emoji {
  font-size: 88rpx;
  line-height: 1;
}
.icon-preview-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
}
.icon-clear {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--text-1);
  color: var(--card);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-change {
  margin-top: 24rpx;
  background: var(--chip);
  color: var(--chip-text);
  border-radius: 40rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
}

/* ---------- 图标选择面板 ---------- */
.icon-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.icon-panel {
  width: 100%;
  height: 78vh;
  background: var(--card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.icon-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.icon-panel-cancel {
  font-size: 28rpx;
  color: var(--text-2);
}
.icon-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}
.icon-panel-ok {
  font-size: 28rpx;
  color: #8b5cf6;
  font-weight: 600;
}
.icon-panel-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.icon-action {
  flex: 1;
  background: var(--chip);
  color: var(--text-1);
  border-radius: 24rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
}
.icon-tabs {
  display: flex;
  background: var(--track);
  border-radius: 24rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.icon-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--chip-text);
}
.icon-tab.on {
  background: var(--card);
  color: var(--text-1);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.icon-search {
  margin-bottom: 20rpx;
}
.icon-search-input {
  background: var(--track);
  border-radius: 40rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
}
.icon-grid-scroll {
  flex: 1;
  min-height: 0;
}
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-bottom: 40rpx;
}
.icon-cell {
  width: calc(20% - 16rpx);
  box-sizing: border-box;
  background: var(--track);
  border-radius: 20rpx;
  padding: 16rpx 8rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.icon-cell-emoji {
  font-size: 52rpx;
  line-height: 1.2;
}
.icon-cell-img {
  width: 72rpx;
  height: 72rpx;
}
.icon-cell-name {
  font-size: 18rpx;
  color: var(--chip-text);
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.icon-empty {
  width: 100%;
  text-align: center;
  color: var(--text-3);
  padding: 80rpx 0;
  font-size: 26rpx;
}
.cur-seg {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.cur-opt {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: var(--chip);
  color: var(--chip-text);
}
.cur-opt.on {
  background: linear-gradient(135deg, #8b5cf6, #c084fc);
  color: #ffffff;
}
.more-opt {
  background: var(--chip);
  color: var(--chip-text);
}
/* 渠道首字徽章 */
.pf-char {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  flex-shrink: 0;
}
/* 选中态：分类图标反白 */
.cat-opt.on .cat-icon {
  filter: brightness(0) invert(1);
}
