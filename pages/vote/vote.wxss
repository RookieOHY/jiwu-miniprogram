.page {
  padding: 24rpx 32rpx;
}

.head-tip {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  margin: 16rpx 0 24rpx;
}

/* 物品摘要 */
.wish {
  margin-bottom: 24rpx;
}
.wish-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}
.wish-price {
  font-size: 30rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  color: var(--text-1);
  margin-top: 8rpx;
}
.wish-note {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-top: 12rpx;
}
.wish-url {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #7c4fe0;
  padding: 4rpx 8rpx;
  margin: 12rpx -8rpx 0 0;
}

/* 投票卡 */
.vote-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.vote-row {
  display: flex;
  gap: 20rpx;
}
.vote-opt {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: 1rpx solid var(--border);
  background: var(--bg);
}
/* 投后高亮 */
.vote-opt.buy.on     { background: rgba(103, 194, 58, 0.14);  color: #4e9e28; border-color: rgba(103, 194, 58, 0.4); }
.vote-opt.think.on   { background: rgba(246, 196, 83, 0.18);  color: #a87d00; border-color: rgba(246, 196, 83, 0.45); }
.vote-opt.no.on      { background: var(--danger-bg);          color: var(--danger-text); border-color: rgba(192, 90, 77, 0.4); }

/* 票数条 */
.tally {
  margin-top: 36rpx;
}
.tally-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.tally-label {
  width: 96rpx;
  font-size: 24rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.tally-bar {
  flex: 1;
  height: 16rpx;
  border-radius: 8rpx;
  background: var(--track);
  overflow: hidden;
}
.tally-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.tally-fill.buy   { background: #67c23a; }
.tally-fill.think { background: #f6c453; }
.tally-fill.no    { background: #c05a4d; }
.tally-num {
  width: 40rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.tally-total {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.tally-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 24rpx 0;
}
.empty-tip {
  margin-top: 20rpx;
  color: #7c4fe0;
  font-size: 26rpx;
}
