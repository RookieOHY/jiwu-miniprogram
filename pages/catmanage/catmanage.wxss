page {
  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
}
.page {
  padding: 24rpx 28rpx;
  padding-bottom: 200rpx;
}
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.g-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}
.g-icon {
  width: 64rpx;
  height: 64rpx;
}
.g-name {
  font-size: 32rpx;
  font-weight: 700;
}
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.sub-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-1);
  background: var(--chip);
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
}
.sub-chip.editing {
  color: var(--danger-text);
  background: var(--danger-bg);
}
.sub-count {
  font-size: 22rpx;
  color: var(--text-2);
}
.sub-x {
  font-size: 28rpx;
}
.sub-empty {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 底部操作条 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 40rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: var(--bg);
  z-index: 20;
}
.bar-btn {
  flex: 1;
  text-align: center;
  border-radius: 48rpx;
  padding: 22rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}
.bar-btn.manage {
  background: var(--chip);
  color: var(--text-1);
}
.bar-btn.add {
  background: var(--accent);
  color: #ffffff;
}
.bottom-space {
  height: 60rpx;
}

/* 菜单 */
.menu-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.menu-sheet {
  width: 100%;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 0 calc(env(safe-area-inset-bottom) + 16rpx);
}
.menu-title {
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border);
}
.menu-item {
  text-align: center;
  font-size: 32rpx;
  padding: 30rpx 0;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--border);
}
.menu-item.cancel {
  color: var(--text-2);
  border-bottom: none;
}
