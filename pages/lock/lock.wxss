.lock {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx 40rpx;
  box-sizing: border-box;
  background: var(--bg);
  color: var(--text-1);
}
.lock-head { text-align: center; }
.lock-logo { width: 96rpx; height: 96rpx; margin-bottom: 20rpx; }
.lock-title { font-size: 34rpx; font-weight: 700; }
.lock-sub { font-size: 24rpx; color: var(--text-dim); margin-top: 10rpx; min-height: 34rpx; }

.dots { display: flex; gap: 28rpx; margin: 56rpx 0 40rpx; }
.dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-dim);
  box-sizing: border-box;
  transition: transform 0.12s ease;
}
.dot.on {
  background: var(--accent);
  border-color: var(--accent);
  transform: scale(1.08);
}
.dots.shake { animation: shake 0.4s; }
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-14rpx); }
  75% { transform: translateX(14rpx); }
}

.pad {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 22rpx;
  margin-top: auto;
}
.key {
  width: 200rpx;
  height: 132rpx;
  border-radius: 28rpx;
  background: var(--card);
  color: var(--text-1);
  font-size: 42rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.key-press { opacity: 0.6; }
.key-fn {
  background: transparent;
  font-size: 26rpx;
  color: var(--text-2);
}
.key-forget { color: var(--accent); }
