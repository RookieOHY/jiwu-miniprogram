<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="page" wx:if="{{item}}">

  <!-- 日均成本主展示 -->
  <view class="hero card">
    <view class="hero-label">{{item.sold ? '卖出后真实日均成本' : (item.retired ? '最终日均成本' : '当前日均成本')}}</view>
    <view class="hero-num">{{item.symbol}}<text class="hero-num-big">{{daily}}</text></view>
    <view class="hero-sub" wx:if="{{!item.retired}}">已持有 {{days}} 天 · 30 天后日均 ¥{{daily30}} · 一年后 ¥{{daily365}}</view>
    <view class="hero-sub" wx:else>共持有 {{days}} 天（{{item.buyDate}} ~ {{item.retiredDate}}）</view>
  </view>

  <!-- 双引擎：日均 / 次均 -->
  <view class="card dual-card">
    <view class="dual-item">
      <view class="dual-num">{{item.symbol}}{{daily}}</view>
      <view class="dual-label">日均成本 / 天</view>
    </view>
    <view class="dual-item" bindtap="editUses">
      <view class="dual-num">{{perUse ? item.symbol + perUse : '—'}}</view>
      <view class="dual-label">次均成本 / 次{{uses ? '（' + uses + '次）' : '（未记录）'}}<text class="ed-inline">›</text></view>
    </view>
    <view class="use-add" catchtap="addUse">＋1</view>
  </view>

  <!-- 回本进度：目标日均 -->
  <view class="card be-card" wx:if="{{be}}">
    <view class="be-head" bindtap="setTarget">
      <text class="be-title">回本进度</text>
      <text class="be-edit">目标日均 ¥{{be.target}} · 改 ›</text>
    </view>
    <view class="be-bar"><view class="be-bar-fill {{be.reached ? 'reached' : ''}}" style="width: {{be.pct}}%"></view></view>
    <view class="be-sub" wx:if="{{be.reached}}">🎉 第 {{be.need}} 天已回本，之后每天都比目标便宜</view>
    <view class="be-sub" wx:else>已持有 {{days}} 天 / 还差 {{be.left}} 天 · 预计 {{be.due}} 回本</view>
  </view>
  <view class="card be-card be-none" wx:elif="{{!item.retired}}" bindtap="setTarget">
    <text class="be-title">设个目标日均，开始攒回本进度</text>
    <text class="be-edit">如「每天低于 ¥1」· 点击设置 ›</text>
  </view>

  <!-- 基本信息 -->
  <view class="card info">
    <view class="row"><text class="k">名称</text><text class="v">{{item.name}}</text></view>
    <view class="row"><text class="k">花费</text><text class="v price">{{item.symbol}}{{item.price}}{{item.qty > 1 ? ' ×' + item.qty + '件（单件 ' + item.symbol + item.unitPrice + '）' : ''}}</text></view>
    <view class="row"><text class="k">购买日期</text><text class="v">{{item.buyDate}}</text></view>
    <view class="row"><text class="k">分类</text><text class="v">{{item.categoryGroup ? item.categoryGroup + ' · ' : ''}}{{item.catName}}</text></view>
    <view class="row" wx:if="{{item.tags.length}}"><text class="k">标签</text><text class="v tag-list">{{fmt.joinTags(item.tags, ' / ')}}</text></view>
    <view class="row ed" wx:if="{{item.startUseDate}}" data-f="startUseDate" bindtap="openDate"><text class="k">开始使用</text><text class="v">{{item.startUseDate}}</text><text class="ed-go">›</text></view>
    <view class="row"><text class="k">购买渠道</text><text class="v">{{item.platformName}}</text></view>
    <view class="row ed" wx:if="{{item.note}}" bindtap="editNote"><text class="k">备注</text><text class="v">{{item.note}}</text><text class="ed-go">›</text></view>
    <view class="row" wx:if="{{item.sold}}">
      <text class="k">卖出日期</text><text class="v">{{item.soldDate}}</text>
    </view>
    <view class="row" wx:if="{{item.sold}}">
      <text class="k">卖出价格</text><text class="v price">{{item.symbol}}{{item.soldPrice}}</text>
    </view>
    <view class="row" wx:if="{{item.sold}}">
      <text class="k">回收差价</text>
      <text class="v price {{item.profitSign === '+' ? 'profit-pos' : 'profit-neg'}}">{{item.profitSign}}{{item.symbol}}{{item.profit}}</text>
    </view>
    <view class="row" wx:if="{{item.retired && !item.sold}}">
      <text class="k">退役日期</text><text class="v">{{item.retiredDate}}</text>
    </view>
    <view class="row">
      <text class="k">状态</text>
      <text class="v">{{item.sold ? '已卖出' : (item.retired ? '已退役（日均已锁定）' : '持有中')}}</text>
    </view>
    <view class="row" wx:if="{{item.fxRecorded}}">
      <text class="k">外币留档</text>
      <text class="v">{{item.fxCurrency}} {{item.fxPrice}} · 汇率 {{item.fxRate}}</text>
    </view>
  </view>

  <!-- 计价与服役 -->
  <view class="card info">
    <view class="sec-head">计价与服役</view>
    <view class="row"><text class="k">计价方式</text><text class="v">{{item.pricingDaily ? '日均计价' : '一次性'}}</text></view>
    <view class="row" wx:if="{{item.recycle}}"><text class="k">循环计价</text><text class="v">开启（订阅制周期付费）</text></view>
    <view class="row ed" wx:if="{{item.expectedRetireDate}}" data-f="expectedRetireDate" bindtap="openDate"><text class="k">预计退役</text><text class="v">{{item.expectedRetireDate}}</text><text class="ed-go">›</text></view>
    <view class="row"><text class="k">服役状态</text><text class="v">{{item.inService ? '服役中' : '闲置'}}</text></view>
    <view class="row ed" wx:if="{{item.valuation}}" bindtap="editValuation"><text class="k">当前估值</text><text class="v price">¥{{item.valuation}}</text><text class="ed-go">›</text></view>
  </view>

  <!-- 期限信息 -->
  <view class="card info" wx:if="{{item.warrantyEnabled}}">
    <view class="sec-head">期限信息</view>
    <view class="row ed" data-f="warrantyDate" bindtap="openDate"><text class="k">保修到期</text><text class="v">{{item.warrantyDate || '点击设置'}}</text><text class="ed-go">›</text></view>
  </view>

  <!-- 额外信息 -->
  <view class="card info" wx:if="{{item.location}}">
    <view class="sec-head">额外信息</view>
    <view class="row ed" bindtap="editLocation"><text class="k">存放位置</text><text class="v">{{item.location}}</text><text class="ed-go">›</text></view>
  </view>

  <!-- 附加收支 -->
  <view class="card info" wx:if="{{item.hasExtras}}">
    <view class="sec-head">附加收支</view>
    <view wx:for="{{item.extras}}" wx:key="index" class="row">
      <text class="k">{{item.type}}</text>
      <text class="v">{{item.name || '未命名'}} · {{item.date}}</text>
      <text class="v price {{item.type === '收入' ? 'profit-pos' : 'profit-neg'}}">{{item.type === '收入' ? '+' : '-'}}¥{{item.amount}}</text>
    </view>
    <view class="row"><text class="k">收支合计</text><text class="v price">{{item.extrasTotal}}</text></view>
  </view>

  <!-- 备注与图片 -->
  <view class="card info" wx:if="{{item.photos.length}}">
    <view class="sec-head">图片</view>
    <view class="photo-row">
      <image wx:for="{{item.photos}}" wx:key="*this" class="photo-thumb" src="{{item}}" mode="aspectFill"/>
    </view>
  </view>

  <!-- 操作 -->
  <view class="ops">
    <button class="op-btn op-plain" bindtap="edit">编辑</button>
    <button
      wx:if="{{!item.sold}}"
      class="btn-primary op-btn"
      bindtap="sell"
    >卖出</button>
    <button
      wx:if="{{item.retired}}"
      class="op-btn op-plain"
      bindtap="unRetire"
    >恢复持有</button>
    <button
      wx:if="{{!item.retired}}"
      class="op-btn op-plain"
      bindtap="retire"
    >退役</button>
    <button class="op-btn op-danger" bindtap="remove">删除</button>
  </view>
</view>

<!-- 行内日期编辑：日历组件 -->
<cal-picker visible="{{showDate}}" value="{{dateValue}}" bindselect="onDateSelect" bindclose="closeDate"/>
