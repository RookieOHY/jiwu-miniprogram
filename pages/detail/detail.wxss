.page {
  padding: 24rpx;
}
.hero {
  background: linear-gradient(180deg, #8b5cf6 0%, #a855f7 40%, #ece3fd 135%);
  color: #ffffff;
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(168, 85, 247, 0.35);
}
.hero-label {
  font-size: 24rpx;
  opacity: 0.75;
}
.hero-num {
  font-size: 44rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  margin: 12rpx 0;
}
.hero-num-big {
  font-size: 96rpx;
  line-height: 1.1;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.75;
}
.info {
  margin-bottom: 40rpx;
}
.row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1ecfa;
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
}
.k {
  width: 160rpx;
  color: #a8a8a0;
  flex-shrink: 0;
}
.v {
  flex: 1;
  word-break: break-all;
}
.price {
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.profit-pos {
  color: #8b5cf6;
}
.profit-neg {
  color: #c05a4d;
}
.ops {
  display: flex;
  gap: 20rpx;
}
.op-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 48rpx;
  padding: 18rpx 0;
  text-align: center;
}
.op-btn::after {
  border: none;
}
.op-plain {
  background: #f3eefe;
  color: #8b5cf6;
}
.op-danger {
  background: #f3e5e2;
  color: #c05a4d;
  flex: 1;
}
