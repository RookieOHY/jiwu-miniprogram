.page {
  padding: 24rpx;
}
.hero {
  background: linear-gradient(180deg, #8b5cf6 0%, #a855f7 40%, var(--hero-end) 135%);
  color: #ffffff;
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--hero-shadow);
}
.hero-label {
  font-size: 24rpx;
  opacity: 0.75;
}
.hero-num {
  font-size: 44rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  margin: 12rpx 0;
}
.hero-num-big {
  font-size: 96rpx;
  line-height: 1.1;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.75;
}
.info {
  margin-bottom: 40rpx;
}
.row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
}
.k {
  width: 160rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.v {
  flex: 1;
  word-break: break-all;
}
.price {
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.profit-pos {
  color: #8b5cf6;
}
.profit-neg {
  color: var(--danger-text);
}
.ops {
  display: flex;
  gap: 20rpx;
}
.op-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 48rpx;
  padding: 18rpx 0;
  text-align: center;
}
.op-btn::after {
  border: none;
}
.op-plain {
  background: var(--chip);
  color: var(--chip-text);
}
.op-danger {
  background: var(--danger-bg);
  color: var(--danger-text);
  flex: 1;
}
