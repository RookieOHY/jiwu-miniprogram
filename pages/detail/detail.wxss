.page {
  padding: 24rpx;
}
.hero {
  background: linear-gradient(135deg, #c9e96b, #a5cd39);
  color: #2b3a0e;
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}
.hero-label {
  font-size: 24rpx;
  opacity: 0.75;
}
.hero-num {
  font-size: 44rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  margin: 12rpx 0;
}
.hero-num-big {
  font-size: 96rpx;
  line-height: 1.1;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.75;
}
.info {
  margin-bottom: 40rpx;
}
.row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2e6;
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
}
.k {
  width: 160rpx;
  color: #a8a8a0;
  flex-shrink: 0;
}
.v {
  flex: 1;
  word-break: break-all;
}
.price {
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.profit-pos {
  color: #7fa32a;
}
.profit-neg {
  color: #c05a4d;
}
.ops {
  display: flex;
  gap: 20rpx;
}
.op-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 48rpx;
  padding: 18rpx 0;
  text-align: center;
}
.op-btn::after {
  border: none;
}
.op-plain {
  background: #f0f2e6;
  color: #2b2b2b;
}
.op-danger {
  background: #f3e5e2;
  color: #c05a4d;
  flex: 1;
}
