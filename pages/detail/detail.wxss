.page {
  padding: 24rpx;
}
.hero {
  background: var(--card);
  color: var(--text-1);
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--hero-shadow);
}
.hero-label {
  font-size: 24rpx;
  opacity: 0.75;
}
.hero-num {
  font-size: 44rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  margin: 12rpx 0;
}
.hero-num-big {
  font-size: 96rpx;
  line-height: 1.1;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.75;
}
.info {
  margin-bottom: 40rpx;
}
.row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
}
.row:last-child {
  border-bottom: none;
}
.k {
  width: 160rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.v {
  flex: 1;
  word-break: break-all;
}
.price {
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.profit-pos {
  color: var(--pos);
}
.profit-neg {
  color: var(--danger-text);
}
.ops {
  display: flex;
  gap: 20rpx;
}
.op-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 48rpx;
  padding: 18rpx 0;
  text-align: center;
}
.op-btn::after {
  border: none;
}
.op-plain {
  background: var(--chip);
  color: var(--chip-text);
}
.op-danger {
  background: var(--danger-bg);
  color: var(--danger-text);
  flex: 1;
}

/* ---------- 回本进度 ---------- */
.be-card {
  margin-bottom: 24rpx;
}
.be-card.be-none {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx;
  border: 1rpx dashed var(--line);
  box-shadow: none;
}
.be-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.be-title {
  font-size: 28rpx;
  font-weight: 700;
}
.be-edit {
  font-size: 22rpx;
  color: var(--text-2);
}
.be-bar {
  height: 14rpx;
  border-radius: 8rpx;
  background: var(--track);
  overflow: hidden;
}
.be-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  background: var(--accent);
}
.be-bar-fill.reached {
  background: var(--pos);
}
.be-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 16rpx;
  line-height: 1.6;
}

/* 新增分组标题与图片 */
.sec-head {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.tag-list {
  color: var(--text-2);
}
.photo-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
}

/* 双引擎：日均 / 次均 */
.dual-card {
  display: flex;
  margin-bottom: 24rpx;
  padding: 32rpx 0;
}
.dual-item {
  flex: 1;
  text-align: center;
}
.dual-num {
  font-size: 44rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  color: var(--text-1);
}
.dual-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

/* 行内可编辑 */
.row.ed {
  cursor: pointer;
}
.ed-go {
  color: var(--text-3);
  font-size: 32rpx;
  margin-left: 12rpx;
}
.ed-inline {
  color: var(--text-3);
  font-size: 22rpx;
  margin-left: 4rpx;
}
.use-add {
  flex-shrink: 0;
  align-self: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(88, 86, 214, 0.12);
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

/* 更多信息折叠开关 */
.more-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: var(--chip);
}
.more-name {
  font-size: 26rpx;
  color: var(--text-2);
}
.more-arrow {
  font-size: 30rpx;
  color: var(--text-3);
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}
.more-arrow.up {
  transform: rotate(-90deg);
}
.more-press {
  opacity: 0.6;
}
