<view class="page">

  <view wx:if="{{!list.length}}" class="empty">
    <view class="empty-icon">✅</view>
    <view>暂无到期提醒</view>
    <view class="empty-tip">保修期、预计退役日临近 30 天内会出现在这里</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card rm-row">
    <view class="rm-main" data-id="{{item.itemId}}" data-kind="{{item.kind}}" bindtap="goDetail">
      <view class="rm-top">
        <text class="rm-tag {{item.overdue ? 'overdue' : ''}}">{{item.tag}} {{item.type}}</text>
        <text class="rm-left {{item.overdue ? 'overdue' : ''}}">{{item.text}}</text>
      </view>
      <view class="rm-name">{{item.name}}</view>
      <view class="rm-date">{{item.date}}</view>
    </view>
    <view class="rm-x" data-id="{{item.id}}" catchtap="hide">×</view>
  </view>

  <view wx:if="{{list.length}}" class="rm-foot" bindtap="restore">恢复已隐藏的提醒</view>
  <view class="bottom-space"></view>
</view>
