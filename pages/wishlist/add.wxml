<view class="page">

  <view class="card form">

    <view class="field">
      <view class="label">物品名称</view>
      <input
        class="input"
        placeholder="例如：降噪耳机 / 咖啡机"
        placeholder-class="ph"
        value="{{name}}"
        bindinput="onName"
        focus
      />
    </view>

    <view class="field">
      <view class="label">价格（预估）</view>
      <input
        class="input"
        type="digit"
        placeholder="0.00"
        placeholder-class="ph"
        value="{{price}}"
        bindinput="onPrice"
      />
      <view wx:if="{{daily}}" class="field-hint">现在不买，先躺 30 天的话，每天 ¥{{daily}}</view>
    </view>

    <view class="field">
      <view class="label">物品链接（可选）</view>
      <input
        class="input"
        placeholder="粘贴商品链接，方便以后回看"
        placeholder-class="ph"
        value="{{url}}"
        bindinput="onUrl"
      />
    </view>

    <view class="field">
      <view class="label">为啥想买（可选）</view>
      <textarea
        class="input textarea"
        placeholder="写下此刻的冲动：是刚需、被种草，还是单纯想要…"
        placeholder-class="ph"
        value="{{reason}}"
        bindinput="onReason"
        maxlength="200"
        auto-height
      />
    </view>

    <view class="field">
      <view class="label">替代品（可选）</view>
      <input
        class="input"
        placeholder="家里已有的、或更便宜的平替"
        placeholder-class="ph"
        value="{{alternative}}"
        bindinput="onAlternative"
      />
    </view>
  </view>

  <button class="btn-primary save-btn {{canSave ? '' : 'dim'}}" disabled="{{!canSave}}" bindtap="save">
    先种一株 🌱
  </button>
</view>
