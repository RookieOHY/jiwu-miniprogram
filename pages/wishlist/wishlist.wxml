<view class="page {{tabAnim}}">

  <!-- 汇总条 -->
  <view class="card head-card" wx:if="{{wishes.length}}">
    <view class="head-item">
      <view class="head-num">{{wishes.length}}</view>
      <view class="head-label">株草</view>
    </view>
    <view class="head-item">
      <view class="head-num">¥{{totalPrice}}</view>
      <view class="head-label">全拔要花</view>
    </view>
    <view class="head-item">
      <view class="head-num">¥{{totalDaily}}</view>
      <view class="head-label">摊 30 天日均</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!wishes.length}}" class="empty">
    <view class="empty-icon">🌱</view>
    <view>还没有种草</view>
    <view class="empty-tip">看到心动的先记一笔，冷静几天再决定</view>
    <button class="btn-primary first-add" bindtap="goAdd">种第一株</button>
  </view>

  <!-- 草单 -->
  <view
    wx:for="{{wishes}}"
    wx:key="id"
    class="card wish"
    data-id="{{item.id}}"
    bindlongpress="onWishLongPress"
  >
    <!-- 标题 + 冷静中徽章 + 价格同行 -->
    <view class="wish-head">
      <view class="wish-name">{{item.name}}<text wx:if="{{item.cooled}}" class="cool-badge">冷静中</text></view>
      <view class="wish-price {{item.price === '' ? 'dim' : ''}}">
        {{item.price === '' ? '待定价' : '¥' + item.price}}
      </view>
    </view>

    <!-- 剁手历史：数过几次、最远数到哪 -->
    <view wx:if="{{item.sessionsText}}" class="wish-note">
      <view class="note-icon icon-count"></view>
      <text class="note-text">{{item.sessionsText}}</text>
    </view>

    <!-- 好友评审票数（云开通且有票时显示） -->
    <view wx:if="{{item.reviewText}}" class="wish-note">
      <view class="note-icon icon-review"></view>
      <text class="note-text review-text">{{item.reviewText}}</text>
    </view>

    <!-- 理由 / 替代品：灰字弱化 -->
    <view wx:if="{{item.reason}}" class="wish-note">
      <view class="note-icon icon-reason"></view>
      <text class="note-text">{{item.reason}}</text>
    </view>
    <view wx:if="{{item.alternative}}" class="wish-note">
      <view class="note-icon icon-alt"></view>
      <text class="note-text">{{item.alternative}}</text>
    </view>

    <!-- 底部 meta：日期 · 日均 · 链接 · 剁手 -->
    <view class="wish-foot">
      <view class="foot-meta">{{item.time}}{{item.daily !== '' ? ' · 日均 ¥' + item.daily : ''}}</view>
      <view class="foot-actions">
        <view wx:if="{{item.url}}" class="foot-link" data-url="{{item.url}}" catchtap="copyLink">
          <view class="note-icon icon-link"></view>
          <text>链接</text>
        </view>
        <view wx:if="{{cloudOn}}" class="foot-review" data-id="{{item.id}}" catchtap="onReview">评审</view>
        <view class="foot-buy" data-id="{{item.id}}" catchtap="goDuoshou">剁手</view>
      </view>
    </view>
  </view>

  <view wx:if="{{wishes.length}}" class="foot-tip">冲动来了点「剁手」· 长按可编辑 / 删除</view>

  <view class="bottom-space"></view>
</view>
