<view class="page">

  <!-- 汇总条 -->
  <view class="card head-card" wx:if="{{wishes.length}}">
    <view class="head-item">
      <view class="head-num">{{wishes.length}}</view>
      <view class="head-label">株草</view>
    </view>
    <view class="head-item">
      <view class="head-num">¥{{totalPrice}}</view>
      <view class="head-label">全拔要花</view>
    </view>
    <view class="head-item">
      <view class="head-num">¥{{totalDaily}}</view>
      <view class="head-label">摊 30 天日均</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!wishes.length}}" class="empty">
    <view class="empty-icon">🌱</view>
    <view>还没有种草</view>
    <view class="empty-tip">看到心动的先记一笔，冷静几天再决定</view>
    <button class="btn-primary first-add" bindtap="goAdd">种第一株</button>
  </view>

  <!-- 草单 -->
  <view
    wx:for="{{wishes}}"
    wx:key="id"
    class="card wish"
    data-id="{{item.id}}"
    bindlongpress="onWishLongPress"
  >
    <view class="wish-head">
      <view class="wish-name">{{item.name}}</view>
      <view class="wish-price">¥{{item.price}}</view>
    </view>
    <view class="wish-daily">现在买，按 30 天摊 ¥{{item.daily}}/天</view>

    <view wx:if="{{item.reason}}" class="wish-row">
      <text class="row-tag reason">为啥想买</text>
      <text class="row-text">{{item.reason}}</text>
    </view>

    <view wx:if="{{item.alternative}}" class="wish-row">
      <text class="row-tag alt">替代品</text>
      <text class="row-text">{{item.alternative}}</text>
    </view>

    <view wx:if="{{item.url}}" class="wish-link" data-url="{{item.url}}" catchtap="copyLink">
      🔗 复制链接
    </view>
  </view>

  <view wx:if="{{wishes.length}}" class="foot-tip">长按可删除 · 拔草转入物品清单开发中</view>

  <view class="bottom-space"></view>
</view>
