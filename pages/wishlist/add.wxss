.page {
  padding: 24rpx;
}
.form {
  margin-bottom: 40rpx;
}
.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.field:last-child {
  border-bottom: none;
}
.label {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.input {
  font-size: 32rpx;
  padding: 8rpx 0;
  width: 100%;
  box-sizing: border-box;
}
.textarea {
  min-height: 80rpx;
}
.ph {
  color: var(--text-3);
}
.field-hint {
  font-size: 24rpx;
  color: #8b5cf6;
  margin-top: 10rpx;
}
.save-btn.dim {
  opacity: 0.4;
}
.save-btn {
  margin-top: 8rpx;
}
