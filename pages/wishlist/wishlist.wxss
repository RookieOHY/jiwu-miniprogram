.page {
  padding: 24rpx 32rpx;
}

/* 汇总条 */
.head-card {
  display: flex;
  margin-bottom: 24rpx;
}
.head-item {
  flex: 1;
  text-align: center;
}
.head-num {
  font-size: 32rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.head-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* 空状态 */
.empty-tip {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.first-add {
  margin: 40rpx auto 0;
  width: 360rpx;
  font-size: 28rpx;
}

/* 草卡 */
.wish {
  margin-bottom: 20rpx;
}

/* 标题 + 价格同行 */
.wish-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}
.wish-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}
.wish-price {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  color: var(--text-1);
}
.wish-price.dim {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-3);
}

/* 理由 / 替代品：灰字弱化，像备忘 */
.wish-note {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
  margin-top: 10rpx;
}

/* 底部 meta 行 */
.wish-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--border);
}
.foot-meta {
  font-size: 22rpx;
  color: var(--text-3);
}
.foot-link {
  font-size: 22rpx;
  font-weight: 600;
  color: #7c4fe0;
  padding: 4rpx 8rpx;
  margin-right: -8rpx;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 8rpx 0 16rpx;
}

/* 给悬浮胶囊让位 */
.bottom-space {
  height: 200rpx;
}
