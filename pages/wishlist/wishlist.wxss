.page {
  padding: 24rpx 32rpx;
}

/* 汇总条 */
.head-card {
  display: flex;
  margin-bottom: 24rpx;
}
.head-item {
  flex: 1;
  text-align: center;
}
.head-num {
  font-size: 34rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.head-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* 空状态 */
.empty-tip {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.first-add {
  margin: 40rpx auto 0;
  width: 360rpx;
  font-size: 28rpx;
}

/* 草卡 */
.wish {
  margin-bottom: 20rpx;
}
.wish-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.wish-name {
  font-size: 32rpx;
  font-weight: 600;
}
.wish-price {
  font-size: 32rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  color: #8b5cf6;
}
.wish-daily {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* 备注 / 替代品行 */
.wish-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
}
.row-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
}
.row-tag.reason {
  background: rgba(139, 92, 246, 0.12);
  color: #7c4fe0;
}
.row-tag.alt {
  background: rgba(125, 167, 217, 0.16);
  color: #4a7ab5;
}
.row-text {
  font-size: 26rpx;
  color: var(--text-1);
  line-height: 1.5;
}

/* 链接 */
.wish-link {
  display: inline-block;
  font-size: 24rpx;
  color: #4a7ab5;
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  background: rgba(125, 167, 217, 0.12);
  border-radius: 24rpx;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 8rpx 0 16rpx;
}

/* 给悬浮胶囊让位 */
.bottom-space {
  height: 200rpx;
}
