page {
  background: var(--bg);
  color: var(--text-1);
}
.page {
  padding: 24rpx 28rpx;
}
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
}
.sec-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 20rpx;
}
.add-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.add-input {
  flex: 1;
  background: var(--track);
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
}
.add-btn {
  flex-shrink: 0;
  background: var(--accent);
  color: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 34rpx;
  font-size: 28rpx;
}
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  background: var(--chip);
  color: var(--text-1);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}
.chip-count {
  font-size: 20rpx;
  color: var(--text-2);
}
.chip-x {
  font-size: 30rpx;
  color: var(--danger-text);
}
.empty {
  font-size: 24rpx;
  color: var(--text-3);
}
.tip {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  padding: 20rpx 0;
}
