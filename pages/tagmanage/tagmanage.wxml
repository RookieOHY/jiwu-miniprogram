<view class="page">
  <view class="card">
    <view class="sec-title">我的标签</view>
    <view class="add-row">
      <input class="add-input" placeholder="新建标签" placeholder-class="ph" value="{{newTag}}" bindinput="onNewTag" confirm-type="done" bindconfirm="add"/>
      <view class="add-btn" bindtap="add">添加</view>
    </view>
    <view class="chip-wrap">
      <view wx:for="{{tags}}" wx:key="*this" class="tag-chip">
        {{item}}
        <text wx:if="{{counts[item]}}" class="chip-count">{{counts[item]}}</text>
        <text class="chip-x" data-t="{{item}}" bindtap="remove">×</text>
      </view>
      <view wx:if="{{!tags.length}}" class="empty">还没有标签</view>
    </view>
  </view>
  <view class="tip">标签会出现在「选择标签」面板里；删除标签不影响已记录的物品</view>
</view>
