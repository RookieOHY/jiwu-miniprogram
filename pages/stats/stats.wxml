<wxs src="../../utils/fmt.wxs" module="fmt" />
<view class="page {{tabAnim}}">

  <!-- 概览 -->
  <view class="card overview">
    <view class="ov-item"><view class="ov-num">{{totalCount}}</view><view class="ov-label">总件数</view></view>
    <view class="ov-item"><view class="ov-num">{{amountHidden ? '¥****' : '¥' + totalSpend}}</view><view class="ov-label">总投入</view></view>
    <view class="ov-item"><view class="ov-num">{{amountHidden ? '¥****' : (valuationCount ? '¥' + currentValue : '—')}}</view><view class="ov-label">现值{{valuationCount ? '' : '（去详情页填估值）'}}</view></view>
  </view>

  <!-- 年度报告入口 -->
  <view class="report-entry" bindtap="goReport" hover-class="row-press" hover-stay-time="80">
    <view class="re-main">
      <view class="re-name">时光账单 · 年度报告</view>
      <view class="re-sub">这一年买了多少、什么最值、闲置率多高</view>
    </view>
    <text class="re-go">查看 ›</text>
  </view>

  <!-- 本月预算 -->
  <view class="sec-title">
    <text>本月预算</text>
    <text class="sec-note">{{budgetMonth}}</text>
  </view>
  <view class="card">
    <view wx:for="{{budgetRows}}" wx:key="scope" class="bud-row" data-s="{{item.scope}}" bindtap="startCap">
      <view class="bud-top">
        <text class="bud-name">{{item.name}}</text>
        <input
          wx:if="{{editScope === item.scope}}"
          class="bud-input"
          type="digit"
          focus="{{true}}"
          value="{{editValue}}"
          placeholder="0 或留空 = 不设"
          placeholder-class="ph"
          data-s="{{item.scope}}"
          catchtap="noop"
          bindinput="onCapInput"
          bindblur="commitCap"
          bindconfirm="commitCap"
        />
        <text wx:else class="bud-num">{{amountHidden ? '****' : item.spent + ' / ' + (item.cap || '未设')}}</text>
      </view>
      <view class="bud-track" wx:if="{{item.cap}}">
        <view class="bud-fill {{item.over ? 'over' : ''}}" style="width: {{item.pct}}%;"></view>
      </view>
      <view class="bud-sub">
        <text wx:if="{{item.over}}" class="bud-over">已超 {{item.overBy}} · 点击改上限</text>
        <text wx:elif="{{item.cap}}">还剩 {{item.left}} · 点击改上限</text>
        <text wx:else>未设上限 · 点击设置</text>
      </view>
    </view>
  </view>

  <!-- 趋势 -->
  <view class="sec-title">
    <text>买入趋势</text>
    <view class="period-switch">
      <view class="p {{period === 'month' ? 'on' : ''}}" data-p="month" bindtap="setPeriod">按月</view>
      <view class="p {{period === 'year' ? 'on' : ''}}" data-p="year" bindtap="setPeriod">按年</view>
    </view>
  </view>
  <view class="card trend">
    <view wx:for="{{months}}" wx:key="key" class="trend-col">
      <view class="trend-bar-wrap"><view class="trend-bar" style="height: {{item.h}}rpx;"></view></view>
      <view class="trend-val">{{amountHidden ? '' : (item.spend || '')}}</view>
      <view class="trend-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 分类分布 -->
  <view class="sec-title"><text>钱花在哪</text></view>
  <view class="card">
    <view wx:for="{{catStats}}" wx:key="name" class="cat-row">
      <image class="cat-ico" src="{{item.icon}}" mode="aspectFit"/>
      <view class="cat-info">
        <view class="cat-top"><text class="cat-name">{{item.name}}</text><text class="cat-pct">{{item.pct}}%</text></view>
        <view class="cat-bar-track"><view class="cat-bar" style="width: {{item.pct}}%;"></view></view>
      </view>
      <text class="cat-val">{{amountHidden ? '****' : '¥' + item.value}}</text>
    </view>
    <view wx:if="{{!catStats.length}}" class="empty-mini">还没有物品数据</view>
  </view>

  <!-- 状态分布 -->
  <view class="sec-title"><text>物品状态</text></view>
  <view class="card status-row">
    <view wx:for="{{statusStats}}" wx:key="name" class="status-cell">
      <view class="status-num">{{item.count}}</view>
      <view class="status-label">{{item.name}}</view>
    </view>
  </view>

  <!-- 使用与闲置（持有中快照） -->
  <view class="sec-title"><text>使用与闲置</text></view>
  <view class="card">
    <view wx:for="{{freqBuckets}}" wx:key="key" class="freq-row">
      <text class="freq-label">{{item.label}}</text>
      <view class="freq-track"><view class="freq-fill" style="width: {{item.w}}%;"></view></view>
      <text class="freq-num">{{item.count}} 件</text>
    </view>
    <view class="freq-sum">闲置金额{{amountHidden ? '' : ('¥' + idleSpend)}}（≥{{dustDaysLabel}}未用）</view>
    <view class="freq-note">快照数据：按最近一次使用距今分桶；实际涨缩需要"定时记录使用"能力，现在主要反映"当前闲置"状态</view>
  </view>

  <!-- 日均排行 -->
  <view class="sec-title"><text>最烧钱 Top5（日均）</text></view>
  <view class="card">
    <view wx:for="{{topDaily}}" wx:key="id" class="rank-row">
      <view class="rank-no {{index < 3 ? 'hot' : ''}}">{{index + 1}}</view>
      <text class="rank-name">{{item.name}}</text>
      <text class="rank-val">{{amountHidden ? '****' : item.symbol + item.daily}}/天</text>
    </view>
    <view wx:if="{{!topDaily.length}}" class="empty-mini">还没有持有中的物品</view>
  </view>

  <view class="bottom-space"></view>
</view>
