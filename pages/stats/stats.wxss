page {
  background: var(--bg);
  color: var(--text-1);
}
.page {
  padding: 24rpx 28rpx;
  padding-bottom: 220rpx;
}
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
}
.overview {
  display: flex;
  padding: 36rpx 0;
}
.ov-item {
  flex: 1;
  text-align: center;
}
.ov-num {
  font-size: 44rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.ov-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}
.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 8rpx 16rpx;
}
.period-switch {
  display: flex;
  background: var(--chip);
  border-radius: 28rpx;
  padding: 4rpx;
}
.p {
  font-size: 22rpx;
  color: var(--chip-text);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}
.p.on {
  background: var(--accent);
  color: #ffffff;
}
.trend {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 320rpx;
}
.trend-col {
  width: 12%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.trend-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.trend-bar {
  width: 60%;
  min-height: 4rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: linear-gradient(to top, #5856D6, #8E8EF7);
}
.trend-val {
  font-size: 18rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}
.trend-label {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}
.cat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}
.cat-ico {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}
.cat-info {
  flex: 1;
  min-width: 0;
}
.cat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cat-name {
  font-size: 26rpx;
}
.cat-pct {
  font-size: 20rpx;
  color: var(--text-2);
}
.cat-bar-track {
  height: 12rpx;
  background: var(--chip);
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 8rpx;
}
.cat-bar {
  height: 100%;
  border-radius: 6rpx;
  background: var(--accent);
}
.cat-val {
  font-size: 24rpx;
  color: var(--text-2);
  font-family: "DIN Alternate", sans-serif;
}
.status-row {
  display: flex;
}
.status-cell {
  flex: 1;
  text-align: center;
}
.status-num {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.status-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}
.rank-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.rank-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--chip);
  color: var(--chip-text);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rank-no.hot {
  background: var(--accent);
  color: #ffffff;
}
.rank-name {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-val {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--danger-text);
  font-family: "DIN Alternate", sans-serif;
}
.empty-mini {
  text-align: center;
  color: var(--text-3);
  font-size: 24rpx;
  padding: 32rpx 0;
}
.bottom-space {
  height: 40rpx;
}

/* 本月预算 */
.sec-note {
  font-size: 22rpx;
  color: var(--text-dim);
  font-weight: 400;
}
.bud-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.bud-row:last-child {
  border-bottom: none;
}
.bud-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.bud-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bud-num {
  font-size: 26rpx;
  color: var(--text-2);
  font-family: "DIN Alternate", sans-serif;
  flex-shrink: 0;
}
.bud-input {
  width: 200rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  font-family: "DIN Alternate", sans-serif;
  border-bottom: 1rpx solid var(--accent);
  padding: 2rpx 4rpx;
}
.bud-track {
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--track);
  margin-top: 12rpx;
  overflow: hidden;
}
.bud-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--accent);
  transition: width 0.25s ease;
}
.bud-fill.over {
  background: var(--danger-text);
}
.bud-sub {
  font-size: 22rpx;
  color: var(--text-dim);
  margin-top: 8rpx;
}
.bud-over {
  color: var(--danger-text);
  font-weight: 600;
}
.ph {
  color: var(--text-dim);
  font-size: 24rpx;
}

/* 年度报告入口 */
.report-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-1);
}
.re-main {
  flex: 1;
  min-width: 0;
}
.re-name {
  font-size: 30rpx;
  font-weight: 700;
}
.re-sub {
  font-size: 22rpx;
  color: var(--text-dim);
  margin-top: 6rpx;
}
.re-go {
  font-size: 24rpx;
  color: var(--accent);
  flex-shrink: 0;
}
.row-press {
  opacity: 0.6;
}

/* 使用与闲置 */
.freq-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.freq-row:last-child {
  border-bottom: none;
}
.freq-label {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-2);
}
.freq-track {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--track);
  overflow: hidden;
  margin-right: 18rpx;
}
.freq-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--accent);
  transition: width 0.3s ease;
}
.freq-num {
  flex-shrink: 0;
  width: 60rpx;
  font-size: 24rpx;
  text-align: right;
  color: var(--text-2);
  font-family: "DIN Alternate", sans-serif;
}
.freq-sum {
  margin: 20rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.freq-note {
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.6;
}
