.page {
  padding: 24rpx 28rpx;
}

/* 年份与总额 */
.yr-card {
  text-align: center;
  padding: 36rpx 28rpx 40rpx;
}
.yr-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
}
.yr {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  min-width: 150rpx;
}
.yr-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  border-radius: 50%;
  background: var(--chip);
  color: var(--text-1);
  font-size: 36rpx;
}
.yr-btn.off {
  color: var(--text-3);
}
.yr-spend {
  font-size: 76rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  line-height: 1.15;
  margin-top: 24rpx;
}
.yr-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}
.yr-none {
  font-size: 22rpx;
  color: var(--text-dim);
  margin-top: 16rpx;
}

/* 四格指标 */
.grid4 {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 0;
}
.g {
  width: 50%;
  box-sizing: border-box;
  text-align: center;
  padding: 20rpx 8rpx;
}
.g-num {
  font-size: 36rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.g-num.warn {
  color: var(--danger-text);
}
.g-num.pos {
  color: var(--pos);
}
.g-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

/* 小节标题 */
.sec-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 32rpx 4rpx 12rpx;
}

/* 排行榜 */
.rank-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.rank-row:last-child {
  border-bottom: none;
}
.rank-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--chip);
  color: var(--text-2);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
}
.rank-main {
  flex: 1;
  min-width: 0;
}
.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-sub {
  font-size: 20rpx;
  color: var(--text-dim);
  margin-top: 2rpx;
}
.rank-val {
  font-size: 28rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  flex-shrink: 0;
}
.rank-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-dim);
  margin-left: 4rpx;
}

/* 普通信息行 */
.row-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 26rpx;
}
.row-line:last-child {
  border-bottom: none;
}
.row-k {
  color: var(--text-2);
  flex-shrink: 0;
}
.row-v {
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-v.pos,
.pos {
  color: var(--pos);
}
.row-press {
  opacity: 0.6;
}

/* 分类条 */
.bud-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.bud-row:last-child {
  border-bottom: none;
}
.bud-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.bud-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bud-num {
  font-size: 24rpx;
  color: var(--text-2);
  font-family: "DIN Alternate", sans-serif;
  flex-shrink: 0;
}
.bud-track {
  height: 10rpx;
  border-radius: 6rpx;
  background: var(--track);
  margin-top: 12rpx;
  overflow: hidden;
}
.bud-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--accent);
}

.empty-mini {
  font-size: 24rpx;
  color: var(--text-dim);
  text-align: center;
  padding: 24rpx 20rpx;
  line-height: 1.6;
}
.empty-tip {
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* 分享 */
.share-btn {
  margin-top: 36rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 22rpx;
  line-height: 92rpx;
  height: 92rpx;
}
.foot-note {
  text-align: center;
  font-size: 20rpx;
  color: var(--text-dim);
  margin-top: 16rpx;
}
.bottom-space {
  height: 60rpx;
}
