.page {
  padding: 24rpx 32rpx;
}

/* 区块标题 */
.sec-title {
  font-size: 26rpx;
  color: #b0a898;
  margin-bottom: 8rpx;
}

/* 设置行 */
.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2ec;
}
.row:last-child {
  border-bottom: none;
}
.row-press {
  opacity: 0.6;
}
.row-main {
  flex: 1;
}
.row-name {
  font-size: 30rpx;
  font-weight: 600;
}
.row-name.danger {
  color: #c05a4d;
}
.row-sub {
  font-size: 24rpx;
  color: #b0a898;
  margin-top: 4rpx;
}
.row-arrow {
  font-size: 40rpx;
  color: #c8c8c0;
  margin-left: 16rpx;
}

/* 给悬浮胶囊让位 */
.bottom-space {
  height: 200rpx;
}
