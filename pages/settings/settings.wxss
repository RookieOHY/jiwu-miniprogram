.page {
  padding: 24rpx 32rpx;
}

/* 区块标题 */
.sec-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
}

/* 设置行 */
.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.row:last-child {
  border-bottom: none;
}
.row-press {
  opacity: 0.6;
}
.row-main {
  flex: 1;
}
.row-name {
  font-size: 30rpx;
  font-weight: 600;
}
.row-name.danger {
  color: var(--danger-text);
}
.row-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}
.row-arrow {
  font-size: 40rpx;
  color: var(--text-3);
  margin-left: 16rpx;
}

/* 给悬浮胶囊让位 */
.bottom-space {
  height: 300rpx;
}

/* picker 包裹的行：末行同样去掉分割线 */
.card > picker:last-child .row {
  border-bottom: none;
}
.row-val {
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.rate-input {
  width: 160rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 600;
  font-family: "DIN Alternate", sans-serif;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--border);
  padding: 4rpx 0;
}
.rate-reset {
  text-align: center;
  font-size: 24rpx;
  color: var(--accent);
  padding: 20rpx 0 4rpx;
}

/* 微信提醒 */
.sec-label {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 20rpx 0 4rpx;
}
.tmpl-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  font-family: "DIN Alternate", sans-serif;
  border-bottom: 1rpx solid var(--accent);
  padding: 4rpx 0;
}
.notify-err {
  font-size: 22rpx;
  color: var(--danger-text);
  padding: 12rpx 0 4rpx;
  line-height: 1.5;
}
.ph {
  color: var(--text-dim);
  font-weight: 400;
}

/* 设置项搜索 */
.set-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
}
.set-search-in {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text-1);
}
.set-ph {
  color: var(--text-dim);
  font-size: 26rpx;
}
.set-search-x {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--chip);
  color: var(--text-2);
  font-size: 30rpx;
  flex-shrink: 0;
}

/* 顶部概览 */
.set-overview {
  display: flex;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}
.ov-cell {
  flex: 1;
  text-align: center;
}
.ov-num {
  font-size: 34rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.ov-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* 长文本截断（模板 ID 等） */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 搜索无结果 */
.set-none {
  text-align: center;
  color: var(--text-dim);
  padding: 80rpx 0;
  font-size: 26rpx;
}
.set-none-sub {
  font-size: 22rpx;
  margin-top: 8rpx;
}
