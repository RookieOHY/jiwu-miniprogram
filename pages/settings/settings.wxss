.page {
  padding: 24rpx 32rpx;
}

/* 区块标题 */
.sec-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
}

/* 设置行 */
.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.row:last-child {
  border-bottom: none;
}
.row-press {
  opacity: 0.6;
}
.row-main {
  flex: 1;
}
.row-name {
  font-size: 30rpx;
  font-weight: 600;
}
.row-name.danger {
  color: var(--danger-text);
}
.row-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}
.row-arrow {
  font-size: 40rpx;
  color: var(--text-3);
  margin-left: 16rpx;
}

/* 给悬浮胶囊让位 */
.bottom-space {
  height: 300rpx;
}

/* picker 包裹的行：末行同样去掉分割线 */
.card > picker:last-child .row {
  border-bottom: none;
}
.row-val {
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.rate-input {
  width: 160rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 600;
  font-family: "DIN Alternate", sans-serif;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--border);
  padding: 4rpx 0;
}
.rate-reset {
  text-align: center;
  font-size: 24rpx;
  color: var(--accent);
  padding: 20rpx 0 4rpx;
}

/* 微信提醒 */
.sec-label {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 20rpx 0 4rpx;
}
.tmpl-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  font-family: "DIN Alternate", sans-serif;
  border-bottom: 1rpx solid var(--accent);
  padding: 4rpx 0;
}
.notify-err {
  font-size: 22rpx;
  color: var(--danger-text);
  padding: 12rpx 0 4rpx;
  line-height: 1.5;
}
.ph {
  color: var(--text-dim);
  font-weight: 400;
}
