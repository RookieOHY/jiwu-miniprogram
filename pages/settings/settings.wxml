<view class="page {{tabAnim}}">

  <!-- 数据 -->
  <view class="card">
    <view class="sec-title">数据</view>
    <view class="row" bindtap="backupMenu" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">备份与恢复</view>
        <view class="row-sub">导出 JSON/CSV 文件、从文件恢复（合并或覆盖）</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="clearData" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name danger">清空全部数据</view>
        <view class="row-sub">删除所有物品记录，不可恢复</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!-- 配置 -->
  <view class="card">
    <view class="sec-title">配置</view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">隐藏底部胶囊文本</view>
        <view class="row-sub">开启后底部导航仅显示图标</view>
      </view>
      <switch checked="{{tabbarHideText}}" color="#5856D6" bindchange="onTabbarHideText"/>
    </view>
  </view>

  <!-- 提醒 -->
  <view class="card">
    <view class="sec-title">提醒</view>
    <view class="row" bindtap="goReminders" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">到期提醒</view>
        <view class="row-sub">保修 / 保质 / 预计退役，提前 30 天提醒</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="sec-title">关于</view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">版本</view>
        <view class="row-sub">MVP · 数据仅保存在本机，不上传服务器</view>
      </view>
    </view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">深色模式</view>
        <view class="row-sub">跟随系统自动切换</view>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
