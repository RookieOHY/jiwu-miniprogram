<view class="page {{tabAnim}}">

  <!-- 外观 -->
  <view class="card">
    <view class="sec-title">外观</view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">深色模式</view>
        <view class="row-sub">跟随系统自动切换</view>
      </view>
    </view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">隐藏底部胶囊文本</view>
        <view class="row-sub">开启后底部导航仅显示图标</view>
      </view>
      <switch checked="{{tabbarHideText}}" color="#5856D6" bindchange="onTabbarHideText"/>
    </view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">隐藏所有金额</view>
        <view class="row-sub">列表、详情、统计均打码，首页眼睛可临时切换</view>
      </view>
      <switch checked="{{amountHidden}}" color="#5856D6" bindchange="onAmountHidden"/>
    </view>
    <picker mode="selector" range="{{viewNames}}" value="{{viewIndex}}" bindchange="onViewPick">
      <view class="row">
        <view class="row-main">
          <view class="row-name">默认视图</view>
          <view class="row-sub">首次打开物品列表的展示方式</view>
        </view>
        <view class="row-val">{{viewNames[viewIndex]}} ›</view>
      </view>
    </picker>
  </view>

  <!-- 提醒 -->
  <view class="card">
    <view class="sec-title">提醒</view>
    <view class="row" bindtap="goReminders" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">到期提醒</view>
        <view class="row-sub">保修 / 退役 / 续费 / 补货 / 保养 / 吃灰 / 预算，现在 {{reminderCount}} 条</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <picker mode="selector" range="{{warnNames}}" value="{{warnIndex}}" bindchange="onWarnPick">
      <view class="row">
        <view class="row-main">
          <view class="row-name">提前几天提醒</view>
          <view class="row-sub">保修、退役、续费到期日</view>
        </view>
        <view class="row-val">{{warnNames[warnIndex]}} ›</view>
      </view>
    </picker>
    <picker mode="selector" range="{{dustNames}}" value="{{dustIndex}}" bindchange="onDustPick">
      <view class="row">
        <view class="row-main">
          <view class="row-name">多久算吃灰</view>
          <view class="row-sub">超过这个天数没记使用就提醒</view>
        </view>
        <view class="row-val">{{dustNames[dustIndex]}} ›</view>
      </view>
    </picker>
    <view class="row">
      <view class="row-main">
        <view class="row-name">预算超支提醒</view>
        <view class="row-sub">本月支出超过分类预算时提醒</view>
      </view>
      <switch checked="{{budgetAlert}}" color="#5856D6" bindchange="onBudgetAlert"/>
    </view>

    <view class="sec-label">微信提醒（订阅消息）</view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">模板 ID</view>
        <view class="row-sub">{{notifyOn ? notifyTmplId : '未配置——提醒只能打开小程序才看得到'}}</view>
      </view>
      <input
        wx:if="{{tmplEditing}}"
        class="tmpl-input"
        placeholder="粘贴模板 ID"
        placeholder-class="ph"
        focus="{{true}}"
        value="{{tmplValue}}"
        bindinput="onTmplInput"
        bindblur="commitTmpl"
        bindconfirm="commitTmpl"
      />
      <text wx:else class="row-val" bindtap="startTmpl">{{notifyOn ? '改' : '填写'}} ›</text>
    </view>
    <view wx:if="{{notifyOn}}" class="row" bindtap="askNotify" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">攒一次授权</view>
        <view class="row-sub">微信规则：授权 1 次只能推 1 条，当前可发 {{notifyQuota}} 条</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view wx:if="{{notifyReady}}" class="row" bindtap="testNotify" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">试发最紧急的一条</view>
        <view class="row-sub">用来验证模板字段是否对得上</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view wx:if="{{notifyErr}}" class="notify-err">{{notifyErr}}</view>
    <view class="row" bindtap="notifyHelp" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">开通步骤</view>
        <view class="row-sub">后台选模板 → 填 ID → 部署 notify 云函数 → 授权</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!-- 隐私 -->
  <view class="card">
    <view class="sec-title">隐私</view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">应用锁</view>
        <view class="row-sub">{{hasPin ? '4 位数字口令，忘记可重置' : '开启前需设置 4 位口令'}}</view>
      </view>
      <switch checked="{{lockOn}}" color="#5856D6" bindchange="onLockSwitch"/>
    </view>
    <view class="row" bindtap="goSetPin" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">{{hasPin ? '修改口令' : '设置口令'}}</view>
        <view class="row-sub">输入两次新口令确认</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">切后台自动上锁</view>
        <view class="row-sub">离开小程序后再回来要重新输入</view>
      </view>
      <switch checked="{{lockBg}}" color="#5856D6" bindchange="onLockBg"/>
    </view>
    <view class="row" bindtap="privacyNote" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">隐私说明</view>
        <view class="row-sub">数据存本机、口令非加密、备份是明文</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!-- 数据 -->
  <view class="card">
    <view class="sec-title">数据</view>
    <view class="row" bindtap="backupMenu" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">备份与恢复</view>
        <view class="row-sub">导出 JSON/CSV 文件、从文件恢复（合并或覆盖）</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="loadDemo" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">载入演示数据</view>
        <view class="row-sub">12 件覆盖保修临期 / 吃灰 / 回本 / 外币 / 附加收支的物品</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view wx:if="{{demoCount}}" class="row" bindtap="clearDemo" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name danger">清除演示数据（{{demoCount}} 件）</view>
        <view class="row-sub">只删演示物品，不影响你自己记录的数据</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="row" bindtap="clearData" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name danger">清空全部数据</view>
        <view class="row-sub">删除所有物品记录，不可恢复</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <!-- 汇率 -->
  <view class="card">
    <view class="sec-title">汇率</view>
    <view class="row" bindtap="toggleRates" hover-class="row-press" hover-stay-time="80">
      <view class="row-main">
        <view class="row-name">外币折算汇率</view>
        <view class="row-sub">用于把外币物品折算成日均人民币，当前展开{{rateOpen ? '中' : '查看'}}</view>
      </view>
      <view class="row-arrow">{{rateOpen ? '▴' : '▾'}}</view>
    </view>
    <block wx:if="{{rateOpen}}">
      <view wx:for="{{rates}}" wx:key="code" class="row">
        <view class="row-main">
          <view class="row-name">{{item.symbol}} {{item.label}}</view>
          <view class="row-sub">1 {{item.code}} = ? 元</view>
        </view>
        <input
          class="rate-input"
          type="digit"
          value="{{item.rate}}"
          data-c="{{item.code}}"
          bindblur="onRateInput"
          bindinput="onRateInput"
        />
      </view>
      <view class="rate-reset" bindtap="resetRates">恢复默认汇率</view>
    </block>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="sec-title">关于</view>
    <view class="row">
      <view class="row-main">
        <view class="row-name">版本</view>
        <view class="row-sub">MVP · 数据仅保存在本机，不上传服务器</view>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
