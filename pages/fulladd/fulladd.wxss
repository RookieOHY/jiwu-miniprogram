page {
  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
}
.page {
  padding: 24rpx 28rpx;
  padding-bottom: 160rpx;
}

/* Tabs */
.tabs {
  display: flex;
  background: var(--chip);
  border-radius: 24rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--chip-text);
}
.tab.on {
  background: var(--accent);
  color: #ffffff;
  font-weight: 600;
}

.sec-title {
  font-size: 26rpx;
  color: var(--text-2);
  padding: 0 8rpx 16rpx;
}
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 36rpx;
}
.sec {
  padding: 28rpx;
}
.sec-label {
  font-size: 24rpx;
  color: var(--text-2);
  margin: 20rpx 0 14rpx;
}

/* 图标 + 名称 */
.row-flex {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}
.icon-slot {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--track);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.icon-img {
  width: 100%;
  height: 100%;
}
.icon-plus {
  font-size: 44rpx;
}
.row-input {
  flex: 1;
  font-size: 30rpx;
  min-width: 0;
}

/* chips */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: var(--chip);
  color: var(--chip-text);
}
.chip-on {
  background: var(--accent);
  color: #ffffff;
}

/* 标签 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.tag {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(88, 86, 214, 0.12);
  color: var(--accent);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.tag-x {
  font-size: 26rpx;
  opacity: 0.7;
}
.mini-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--accent);
  padding: 8rpx 20rpx;
}

/* 字段行 */
.field-line {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.field-line:last-of-type {
  border-bottom: none;
}
.f-label {
  width: 200rpx;
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.f-input {
  flex: 1;
  font-size: 28rpx;
  min-width: 0;
}
.f-input.price {
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.f-auto {
  font-size: 26rpx;
  color: var(--text-2);
}
.currency {
  flex-shrink: 0;
  font-size: 26rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: var(--chip);
  color: var(--chip-text);
  margin-left: 10rpx;
}
.currency.on {
  background: var(--accent);
  color: #ffffff;
}
.date-chip {
  background: var(--track);
  color: var(--text-1);
  font-size: 26rpx;
  border-radius: 14rpx;
  padding: 10rpx 22rpx;
}

/* 开关行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}
.row-name {
  font-size: 28rpx;
  font-weight: 600;
}
.row-sub {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 4rpx;
}

/* 备注 */
.note-area {
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  font-size: 28rpx;
  background: var(--track);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}
.photo-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.photo {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
.photo image {
  width: 100%;
  height: 100%;
}
.photo.add {
  background: var(--track);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--text-3);
}
.photo-x {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 附加收支 */
.extra-type {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.mini-add {
  margin: 24rpx 0 8rpx;
  width: 100%;
  background: var(--accent);
  color: #ffffff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 0;
  line-height: 1.4;
}
.mini-add::after {
  border: none;
}
.extra-list {
  margin-top: 12rpx;
}
.extra-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 26rpx;
}
.extra-type-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.extra-type-tag.in {
  background: rgba(52, 199, 89, 0.12);
  color: var(--pos);
}
.extra-type-tag.out {
  background: rgba(255, 59, 48, 0.1);
  color: var(--danger-text);
}
.extra-name {
  flex: 1;
  color: var(--text-1);
}
.extra-amount {
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.extra-amount.in {
  color: var(--pos);
}
.extra-amount.out {
  color: var(--danger-text);
}
.extra-x {
  color: var(--text-3);
  font-size: 32rpx;
  padding: 0 6rpx;
}
.extra-empty {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.ph {
  color: var(--text-3);
}

.bottom-gap {
  height: 40rpx;
}
.save-btn {
  border-radius: 48rpx;
}
