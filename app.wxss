/* ============ 胶囊 Tab 切换动画（页面内容方向感知滑入） ============ */
.tab-anim-fade {
  animation: tabFade 0.22s ease;
}
.tab-anim-right {
  animation: tabRight 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.tab-anim-left {
  animation: tabLeft 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
}
@keyframes tabFade {
  from { opacity: 0; }
}
@keyframes tabRight {
  from { opacity: 0.3; transform: translateX(28rpx); }
}
@keyframes tabLeft {
  from { opacity: 0.3; transform: translateX(-28rpx); }
}

/* ============ 夜间模式：只翻转变量 ============ */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #000000;
    --card: #1C1C1E;
    --text-1: #ffffff;
    --text-2: #98989d;
    --text-3: #5a5a5e;
    --text-dim: #98989d;
    --border: rgba(84, 84, 88, 0.6);
    --chip: #2C2C2E;
    --chip-text: #b8b8bf;
    --track: #2C2C2E;
    --line: rgba(84, 84, 88, 0.6);
    --sep: rgba(84, 84, 88, 0.6);
    --hero-end: #1C1C1E;
    --accent: #5E5CE6;
    --accent-soft: rgba(94, 92, 230, 0.25);
    --pos: #30D158;
    --danger-bg: rgba(255, 69, 58, 0.15);
    --danger-text: #FF453A;
    --shadow-1: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
    --shadow-press: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
    --logo-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
    --hero-shadow: var(--shadow-1);
  }

  /* 中性胶囊底色 */
  .cat-opt       { color: #a79bc4; }
  .cat-opt.cat-food        { background: rgba(246, 196, 83, 0.14); }
  .cat-opt.cat-electronic  { background: rgba(125, 167, 217, 0.14); }
  .cat-opt.cat-clothing    { background: rgba(232, 160, 154, 0.14); }
  .cat-opt.cat-home        { background: rgba(155, 192, 138, 0.14); }
  .cat-opt.cat-study       { background: rgba(179, 157, 219, 0.14); }
  .cat-opt.cat-sport       { background: rgba(241, 154, 126, 0.14); }
  .cat-opt.cat-other       { background: rgba(196, 187, 168, 0.10); }
  .cat-opt.pf-jd   { background: rgba(225, 37, 27, 0.15); }
  .cat-opt.pf-tb   { background: rgba(255, 80, 0, 0.15); }
  .cat-opt.pf-pdd  { background: rgba(226, 46, 31, 0.15); }
  .cat-opt.pf-vip  { background: rgba(228, 0, 127, 0.15); }
  .cat-opt.pf-xy   { background: rgba(255, 230, 15, 0.12); }
  .cat-opt.pf-wx   { background: rgba(7, 193, 96, 0.14); }
  .cat-opt.pf-dy   { background: rgba(255, 255, 255, 0.08); color: #eae5f4; }
  .cat-opt.pf-off  { background: rgba(138, 109, 59, 0.18); }
  .cat-opt.pf-amazon { background: rgba(255, 153, 0, 0.15); }
  .cat-opt.pf-ebay   { background: rgba(0, 100, 210, 0.18); }
  .cat-opt.pf-iherb  { background: rgba(67, 160, 71, 0.16); }
  .cat-opt.pf-shein  { background: rgba(255, 255, 255, 0.10); color: #eae5f4; }
