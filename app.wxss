.pfc-tb   { background: #ff5000; }
.pfc-pdd  { background: #e22e1f; }
.pfc-vip  { background: #e4007f; }
.pfc-xy   { background: #f5c400; }
.pfc-wx   { background: #07c160; }
.pfc-dy   { background: #161823; }
.pfc-off  { background: #8a6d3b; }
