.cat-opt.pf-tb   { background: rgba(255, 80, 0, 0.08); color: #e8541c; }
.cat-opt.pf-pdd  { background: rgba(226, 46, 31, 0.08); color: #d43a2f; }
.cat-opt.pf-vip  { background: rgba(228, 0, 127, 0.08); color: #c9006f; }
.cat-opt.pf-xy   { background: rgba(255, 230, 15, 0.18); color: #9c8a00; }
.cat-opt.pf-wx   { background: rgba(7, 193, 96, 0.09); color: #129a52; }
.cat-opt.pf-dy   { background: rgba(22, 24, 35, 0.08); color: #161823; }
.cat-opt.pf-off  { background: rgba(138, 109, 59, 0.10); color: #8a6d3b; }
.cat-opt.pf-amazon { background: rgba(255, 153, 0, 0.12); color: #b36b00; }
.cat-opt.pf-ebay   { background: rgba(0, 100, 210, 0.10); color: #0064d2; }
.cat-opt.pf-iherb  { background: rgba(67, 160, 71, 0.10); color: #2e7d32; }
.cat-opt.pf-shein  { background: rgba(17, 17, 17, 0.08); color: #111111; }
.cat-opt.pf-temu   { background: rgba(251, 119, 1, 0.12); color: #d96a00; }
.cat-opt.pf-ali    { background: rgba(230, 46, 4, 0.10); color: #e62e04; }

