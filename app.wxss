page {
  background: #f7f7f2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #2b2b2b;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(43, 43, 43, 0.05);
}

/* 通用按钮（黄绿主色） */
.btn-primary {
  background: #a5cd39;
  color: #2b2b2b;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-primary::after {
  border: none;
}
.btn-primary[disabled] {
  opacity: 0.4;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #b0a898;
  padding: 100rpx 0;
}
.empty .empty-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

/* 分类色板 */
.cat-food      { background: #f6c453; }
.cat-electronic{ background: #7da7d9; }
.cat-clothing  { background: #e8a09a; }
.cat-home      { background: #9bc08a; }
.cat-study     { background: #b39ddb; }
.cat-sport     { background: #f19a7e; }
.cat-other     { background: #c4bba8; }

/* 购买渠道品牌色（淡底 + 品牌色文字），加 .cat-opt 提升优先级避免被页面样式覆盖 */
.cat-opt.pf-jd   { background: rgba(225, 37, 27, 0.08); color: #d43a2f; }
.cat-opt.pf-tb   { background: rgba(255, 80, 0, 0.08); color: #e8541c; }
.cat-opt.pf-pdd  { background: rgba(226, 46, 31, 0.08); color: #d43a2f; }
.cat-opt.pf-vip  { background: rgba(228, 0, 127, 0.08); color: #c9006f; }
.cat-opt.pf-xy   { background: rgba(255, 230, 15, 0.18); color: #9c8a00; }
.cat-opt.pf-wx   { background: rgba(7, 193, 96, 0.09); color: #129a52; }
.cat-opt.pf-dy   { background: rgba(22, 24, 35, 0.08); color: #161823; }
.cat-opt.pf-off  { background: rgba(138, 109, 59, 0.10); color: #8a6d3b; }
.cat-opt.pf-amazon { background: rgba(255, 153, 0, 0.12); color: #b36b00; }
.cat-opt.pf-ebay   { background: rgba(0, 100, 210, 0.10); color: #0064d2; }
.cat-opt.pf-iherb  { background: rgba(67, 160, 71, 0.10); color: #2e7d32; }
.cat-opt.pf-shein  { background: rgba(17, 17, 17, 0.08); color: #111111; }
.cat-opt.pf-temu   { background: rgba(251, 119, 1, 0.12); color: #d96a00; }
.cat-opt.pf-ali    { background: rgba(230, 46, 4, 0.10); color: #e62e04; }

/* 分类标签淡底彩字（与渠道标签同风格） */
.cat-opt.cat-food       { background: rgba(246, 196, 83, 0.16); color: #a87d00; }
.cat-opt.cat-electronic{ background: rgba(125, 167, 217, 0.16); color: #4a7ab5; }
.cat-opt.cat-clothing  { background: rgba(232, 160, 154, 0.16); color: #d47a72; }
.cat-opt.cat-home      { background: rgba(155, 192, 138, 0.16); color: #6f9a5c; }
.cat-opt.cat-study     { background: rgba(179, 157, 219, 0.16); color: #7e57c2; }
.cat-opt.cat-sport     { background: rgba(241, 154, 126, 0.16); color: #d97048; }
.cat-opt.cat-other     { background: rgba(196, 187, 168, 0.18); color: #8a8378; }

