page {
  /* 色彩变量：明暗两套，页面样式一律引用变量（Apple 语义色） */
  --bg: #F2F2F7;
  --card: #ffffff;
  --text-1: #1c1c1e;
  --text-2: #8e8e93;
  --text-3: #c7c7cc;
  --text-dim: #aeaeb2;
  --border: rgba(60, 60, 67, 0.15);
  --chip: #F2F2F7;
  --chip-text: #3c3c43;
  --track: #F2F2F7;
  --line: rgba(60, 60, 67, 0.25);
  --sep: rgba(60, 60, 67, 0.25);
  --hero-end: #ffffff;
  --accent: #5856D6;
  --accent-soft: rgba(88, 86, 214, 0.12);
  --pos: #34C759;
  --danger-bg: rgba(255, 59, 48, 0.1);
  --danger-text: #FF3B30;
  --shadow-1: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --shadow-press: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  --logo-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  --hero-shadow: var(--shadow-1);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--text-1);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-1);
}

/* 通用按钮（Accent 实色，Apple 式克制） */
.btn-primary {
  background: var(--accent);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-primary::after {
  border: none;
}
.btn-primary[disabled] {
  opacity: 0.4;
}

/* 空状态 */
.empty {
  text-align: center;
  color: var(--text-dim);
  padding: 100rpx 0;
}
.empty .empty-icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

/* 分类色板 */
.cat-food      { background: #f6c453; }
.cat-electronic{ background: #7da7d9; }
.cat-clothing  { background: #e8a09a; }
.cat-home      { background: #9bc08a; }
.cat-study     { background: #b39ddb; }
.cat-sport     { background: #f19a7e; }
.cat-other     { background: #c4bba8; }

/* 购买渠道品牌色（淡底 + 品牌色文字），加 .cat-opt 提升优先级避免被页面样式覆盖 */
